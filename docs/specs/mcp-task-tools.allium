-- allium: 3
-- mcp-task-tools.allium
--
-- Scope: MCP tools for task management (create, get, update, list,
--        dispatch, send-message, subscribe/unsubscribe-to-task, query-usage,
--        set-verify-command) and the CLI plan-attachment surface.
-- Excludes: Task lifecycle (see tasks.allium); dispatch/retry (see dispatch.allium);
--           MCP epic tools (see epics.allium); learnings tools (see learnings.allium);
--           repo indexing / semantic search (see repo-rag.allium); the
--           task-watcher domain rules underlying subscribe_to_task/
--           unsubscribe_from_task (see task-watchers.allium).

use "./core.allium" as core

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == MCP Task Tools ==

rule UpdateTaskViaMcp {
    when: McpUpdateTask(task, status?, sub_status?, plan?, title?, description?,
                        repo_path?, sort_order?, url?, url_type?, tag?, epic_id?,
                        base_branch?, wrap_up_mode?, auto_run_plan?)

    requires: status != null or sub_status != null or plan != null or title != null
              or description != null or repo_path != null
              or sort_order != null or epic_id != null
              or url != null or tag != null
              or base_branch != null
              or wrap_up_mode != omitted
              or auto_run_plan != null

    -- Typed-url validation contract. The url string and its type travel
    -- together; the handler rejects inconsistent combinations before any
    -- mutation occurs.
    --   • A non-empty url REQUIRES url_type (an unaccompanied url is rejected).
    --   • An unknown url_type (not one of UrlType's literals) is rejected.
    requires:
        if url != null and url != "":
            url_type != null and url_type_is_valid(url_type)

    -- Cannot set status to done or archived via MCP. This restriction
    -- is enforced at the MCP handler boundary, not in the service layer.
    -- Rationale: agents manage running work, humans mark completion.
    --
    -- These two guards are the ONLY status constraint on this path, and
    -- they constrain the TARGET status only — task.status is never read
    -- to validate the move. This rule is therefore exempt from
    -- core/Task's status transition graph (see core.allium:
    -- Task.transitions status): any status other than done and archived
    -- is accepted from any current status, with no edge check, including
    -- out of the graph's terminal `archived` state. Deliberate: agents
    -- legitimately re-open and re-queue their own work
    -- (`review -> backlog`, `done -> backlog`), which the graph does not
    -- declare.
    requires: status != done
    requires: status != archived

    -- sub_status must be valid for the task's current (or new) status
    requires:
        if sub_status != null:
            let effective_status = if status != null: status else: task.status
            sub_status.is_valid_for(effective_status)

    let prior_status = task.status

    ensures:
        if status != null: task.status = status
    ensures:
        if sub_status != null: task.sub_status = sub_status
        else if status != null: task.sub_status = core/SubStatus.default_for(status)
    ensures:
        if plan != null: task.plan_path = plan
    ensures:
        if title != null: task.title = title
    ensures:
        if description != null: task.description = description
    ensures:
        if repo_path != null: task.repo_path = expand_tilde(repo_path)
    ensures:
        if sort_order != null: task.sort_order = sort_order
    ensures:
        -- Leaving done via the status param clears the completion-recency
        -- rank, overriding an explicit sort_order in the same call (this
        -- clause runs after the sort_order clause above). Mirrors
        -- tasks/MoveTaskBackward's leaving-done clear and
        -- epics/UpdateEpicViaMcp's status-driven override. Only the clearing
        -- half appears here: `requires: status != done` already rules out
        -- the entering-done set that tasks/ConfirmDone performs.
        if status != null and prior_status = done:
            task.sort_order = null
    ensures:
        -- Leaving running voids any deferred Stop, exactly as the manual
        -- moves in tasks.allium do. Without this an agent that moves its own
        -- task out of running and later back in would be flipped straight
        -- back out by ReconcileStrandedPendingStop (agent-health.allium).
        -- See core/Task's PendingStopOnlyWhileRunning invariant.
        if status != null and status != running and prior_status = running:
            task.stop_pending = false
    ensures:
        if url != null:
            if url = "":
                task.url = null      -- empty string clears the url (and its type)
            else:
                task.url = core/TaskUrl{url: url, url_type: url_type}
    ensures:
        if tag != null: task.tag = tag
    ensures:
        if epic_id != null: task.epic = route_target(core/Epic.find(epic_id), task.repo_path)
    ensures:
        if base_branch != null: task.base_branch = base_branch
    ensures:
        -- wrap_up_mode supports three states: omitted (no change), one of
        -- WrapUpMode's literals (set), or explicit null (clear to NULL).
        if wrap_up_mode != omitted: task.wrap_up_mode = wrap_up_mode
    ensures:
        if auto_run_plan != null: task.auto_run_plan = auto_run_plan
    ensures: task.updated_at = now

    @guidance
        -- MCP update_task accepts status, sub_status, plan_path, title,
        -- description, repo_path, sort_order, url, url_type, tag, epic_id,
        -- base_branch, and wrap_up_mode. It does NOT accept
        -- worktree or tmux_window — those are owned by the dispatch flow
        -- and never set via MCP.
        -- wrap_up_mode can be set to "rebase", "pr", or "done" to pre-set
        -- the wrap-up action for the task. Pass null explicitly to clear it
        -- (omitting the field is a no-op).
        -- auto_run_plan (boolean, not nullable at the Task level) can be
        -- set via create_task or update_task. Omitting it is a no-op on
        -- update; create_task defaults it to false when absent.
        -- Note: worktree and tmux_window ARE mutable through the internal
        -- Rust TaskService::update_task API (UpdateTaskParams defines
        -- them; see src/service/tasks/params.rs). The runtime uses that
        -- path for detach and for the post-provision patch on both dispatch
        -- paths (dispatch_task and the epic chain).
        -- They are intentionally unreachable from MCP because the MCP
        -- handler does not parse those fields: the UpdateTaskArgs struct
        -- that defines the accepted argument set
        -- (src/mcp/handlers/tasks/mod.rs) has no worktree or
        -- tmux_window field, so handle_update_task
        -- (src/mcp/handlers/tasks/crud.rs) can never carry them into
        -- UpdateTaskParams.
        -- The typed url is carried by two params: `url` (the string) and
        -- `url_type` (one of pr | security_alert | issue | other). A non-empty
        -- `url` REQUIRES `url_type`; an unknown `url_type` is rejected. An
        -- empty-string `url` clears task.url and its type (maps to
        -- FieldUpdate::Clear); any non-empty `url` sets task.url to a
        -- core/TaskUrl{url, url_type} value.
        -- The leaving-done sort_order clear is not MCP-specific: it lives in
        -- TaskService::update_task (src/service/tasks/crud.rs), which reads
        -- the pre-write status and consults
        -- sort_order_for_status_transition (src/models/tasks.rs), applying
        -- the result on top of the patch built from the caller's params. MCP
        -- is simply one of the callers that can reach it — the one that can
        -- reach only its clearing half, since it cannot set status = done.
        -- When status or epic_id changes, the parent epic's status is
        -- recalculated (if a parent epic exists). Re-assigning a task
        -- from one epic to another triggers recalculation on both the
        -- old and new epic.
        -- When epic_id refers to a grouped root (group_by_repo = true),
        -- route_target redirects the task to the per-repo sub-epic for
        -- task.repo_path, creating the sub-epic if needed. When epic_id
        -- refers to a specific sub-epic, the assignment is direct.
        -- origin is never user-supplied: it is a system field set only
        -- by the repo-grouping service (service::grouping). Callers
        -- cannot set or observe origin via MCP.
        -- When repo_path is changed alongside or independently, and the
        -- task belongs to a grouped parent, reroute_on_repo_change is
        -- called to move the task to the correct sub-epic for the new
        -- repo_path.
}

rule PrFinalisationReflectionNudge {
    when: McpUpdateTask(task, status?, sub_status?, plan?, title?, description?,
                        repo_path?, sort_order?, url?, url_type?, tag?, epic_id?,
                        base_branch?, wrap_up_mode?, auto_run_plan?)

    -- "PR finalisation": this one call both moves the task to review and
    -- attaches a pr-typed url, on a task that carried no url at all before the
    -- call. Preconditions read pre-call state, so task.url = null is the
    -- first-time-a-PR-is-linked condition, not a post-update assertion.
    requires: status = review
    requires: url != null and url != "" and url_type = pr
    requires: task.url = null

    requires: core/config.learning_reflection_enabled = true

    ensures: ReflectionNudgeAppended(task: task)

    @guidance
        -- The sole consumer of core/config.learning_reflection_enabled. The
        -- nudge is a sentence appended to the update_task success response
        -- text, asking the agent whether it discovered anything non-obvious
        -- about the repo or task and, if so, to call record_learning with a
        -- brief summary. It never gates or alters the update: UpdateTaskViaMcp
        -- applies its mutations regardless, and when the flag is false the
        -- response text is simply shorter.
        --
        -- Layering: the finalisation shape is computed in the service layer as
        -- was_pr_finalisation (src/service/tasks/crud.rs) — status = review AND
        -- a pr-typed url AND the pre-write task had url = None — and returned on
        -- UpdateTaskResult. handle_update_task (src/mcp/handlers/tasks/crud.rs)
        -- consults it and only then calls reflection_nudge
        -- (src/mcp/handlers/tasks/mod.rs), which reads the setting and returns
        -- the empty string when it is false.
        --
        -- IMPORTANT — this nudge does NOT fire on the normal wrap-up path.
        -- ExitSessionViaMcp (below) performs an equivalent mutation for
        -- action = pr (status -> review plus a pr-typed url, set
        -- unconditionally regardless of any prior url), but handle_exit_session
        -- (src/mcp/handlers/tasks/wrap_up.rs) calls
        -- state.task_svc.update_task(...) directly at the service layer and
        -- discards the returned was_pr_finalisation; it never calls
        -- reflection_nudge. So the nudge only appears when a caller invokes the
        -- update_task MCP tool directly to link a PR, bypassing
        -- wrap_up/exit_session entirely. The wrap_up response carries a
        -- different, unconditional nudge about rate_learning (see
        -- learnings.allium: WrapUpReflection).
}

rule CreateTaskViaMcp {
    when: McpCreateTask(caller_identity,
                        title, repo_path, description?, plan?,
                        epic_id?, sort_order?, tag?, base_branch?,
                        wrap_up_mode?, auto_run_plan?)

    -- caller_identity is supplied by the dispatch HTTP transport, not by
    -- the tool arguments. It is one of:
    --   Task(task_id)   — dispatched agent; CWD matched .worktrees/<id>-<slug>
    --   Session         — any non-dispatched session
    --
    -- The X-Caller-Task-Id and X-Caller-Kind HTTP headers are produced
    -- by the `dispatch caller-headers` headersHelper installed in
    -- Claude Code's user-global config (~/.claude.json) by `dispatch setup`.

    -- A Task-kind caller must reference an existing task.
    requires:
        if caller_identity.kind = task: core/Task.exists(caller_identity.task_id)

    -- Explicit epic_id, when given as a non-null value, must refer to an
    -- existing epic.
    requires:
        if epic_id != null: core/Epic.exists(epic_id)

    ensures: core/Task.created(
        title: title,
        description: description ?? "",
        repo_path: repo_path,
        status: backlog,
        sub_status: core/SubStatus.default_for(backlog),
        plan_path: plan,
        epic: effective_epic,
        tag: tag,
        sort_order: sort_order,
        base_branch: base_branch ?? core/config.default_branch,
        wrap_up_mode: wrap_up_mode,
        auto_run_plan: auto_run_plan ?? false,
        created_at: now,
        updated_at: now
    )

    -- NOTE: allium parser does not support `let` bindings or nested
    -- if/then/else expressions inside this rule, so the effective-value
    -- derivation is documented here in pseudo-code. The behaviour is
    -- enforced by handle_create_task in src/mcp/handlers/tasks/crud.rs:
    --   effective_epic =
    --       if epic_id is set: Epic.find(epic_id) (or null when epic_id = null)
    --       else if caller is Task(t): Task.find(t).epic
    --       else: null

    @guidance
        -- Dispatched agents never pass caller_task_id explicitly — the
        -- transport carries identity. The dispatched-agent's worktree
        -- path (`.worktrees/<task-id>-<slug>`) is parsed by the
        -- `dispatch caller-headers` headersHelper, which emits
        -- `X-Caller-Task-Id: <id>` on every MCP request.
        -- Non-dispatched sessions emit `X-Caller-Kind: session` instead.
        -- Passing epic_id: null explicitly (as opposed to omitting it)
        -- means "no epic" even when the caller has one.
        --
        -- The Axum middleware (src/mcp/middleware.rs) is an *extractor*,
        -- not a gatekeeper: it parses the two headers and attaches a
        -- Result<CallerIdentity, IdentityError> to request extensions
        -- without ever short-circuiting the request. This is required
        -- because the middleware runs before the JSON-RPC body is
        -- parsed and therefore has no request id to echo back — and a
        -- JSON-RPC response with `id: null` is rejected by strict MCP
        -- clients (Claude Code), which would abort the session during
        -- the handshake.
        --
        -- Identity-free methods (`initialize`, `ping`, `tools/list`,
        -- notifications) succeed regardless of header presence.
        -- Identity-consuming tool calls (everything dispatched through
        -- `tools/call`) reject missing or malformed identity at the
        -- handler boundary with JSON-RPC -32600, echoing back the
        -- request's actual id.
        -- An unknown caller-task is a not-found condition, not a
        -- validation one: the shared caller-task lookup (fetch_caller_task
        -- in src/mcp/handlers/types.rs) rejects it with -32001, the same
        -- code every ServiceError::NotFound maps to.
        -- An unknown epic_id is a separate, hand-rolled check that still
        -- returns -32602 (src/mcp/handlers/tasks/dispatch.rs).
        -- Unlike the TUI CreateTask rule, this rule does not fire
        -- RecordRepoPath — MCP task creation skips repo path persistence.
        -- repo_path is expanded through expand_tilde before being
        -- stored (so "~/proj" becomes "$HOME/proj"), matching
        -- UpdateTaskViaMcp.
}

rule GetTaskViaMcp {
    when: McpGetTask(task_id)

    requires: core/Task.exists(task_id)

    -- Read-only. Returns the task detail view for task_id; no state changes.
    ensures: TaskRetrieved(task_id)

    @guidance
        -- get_task takes only task_id and is the tool a dispatched agent uses
        -- to read its own task (title, description, plan, tag, wrap_up_mode).
        -- Caller identity is not consulted: any caller may read any task, and
        -- there is no auto-scoping or self-exclusion as in ListTasksViaMcp.
        -- Detail lines, in render order (lines in [brackets] appear only when
        -- the field is set):
        --   Task <id>: <title>, Status, Repo, Description, Sub-status,
        --   [Epic (as "<title> (#<id>)", or "#<id>" when the title cannot be
        --   resolved)], [Tag], [Plan], [<url label>: <url> — the typed label
        --   derived from url.url_type], [Worktree], Base branch,
        --   [Tmux window], [Sort order], [Wrap-up mode], Created, Updated.
        -- Not surfaced at all: labels, external_id, auto_run_plan, origin, and
        -- the hook timestamps (last_pre_tool_use_at, last_notification_at,
        -- pr_learnings_gate_shown_at).
        -- An unknown task_id is a not-found condition, not a validation one:
        -- ServiceError::NotFound surfaces as the -32001 not-found code, the
        -- same mapping every other NotFound uses (see CreateTaskViaMcp).
        -- Handled by handle_get_task in src/mcp/handlers/tasks/crud.rs.
}

rule ListTasksViaMcp {
    when: McpListTasks(caller_identity,
                       epic_id?, repo_paths?, status?)

    -- caller_identity comes from the HTTP transport (see CreateTaskViaMcp).

    ensures: TasksQueried(
        caller_identity: caller_identity,
        epic_id: epic_id,
        repo_paths: repo_paths,
        status: status
    )

    @guidance
        -- When the caller is Task(t) and none of epic_id/repo_paths
        -- are set, auto-derive scope from the caller:
        --   caller.epic_id != null → filter by epic_id = caller.epic_id
        -- Explicit scope filters always win over auto-derived scope.
        -- When the caller is Task(t) alongside an explicit scope filter, the
        -- caller's task is still excluded from results but no additional
        -- scope is derived.
        -- When the caller is Session, no auto-scope and no self-exclusion.
        -- Output line per task: title, status/sub_status, tag, epic, then
        --   | <label>: <url.url>  (omitted when url is null), where <label>
        --     is the typed label derived from url.url_type: "PR #N" / "Issue #N"
        --     / "Security Alert" / "Link"
        --   | Goal: <plan goal>  (from **Goal:** line in plan file; falls back to
        --                         description preview ≤200 chars when plan absent/unreadable)
        -- Implemented in handle_list_tasks (src/mcp/handlers/tasks/crud.rs).
}

rule QueryUsageViaMcp {
    when: McpQueryUsage(category?, actor?, since?)

    -- category and actor, when supplied, are validated against their
    -- enums; an unrecognised value is rejected rather than silently
    -- yielding an empty result.
    requires:
        if category != null: usage_category_is_valid(category)
    requires:
        if actor != null: usage_actor_is_valid(actor)

    ensures: FeatureUsageQueried(
        category: category,
        actor: actor,
        since: since
    )

    @guidance
        -- query_usage returns aggregated feature-usage counts grouped by
        -- category + action (with detail, actor, total count and the most
        -- recent use timestamp per group). Filters are optional:
        --   category: "keybinding" | "mcp_tool" (enum-validated)
        --   actor:    enum-validated string
        --   since:    ISO-8601 datetime; rows older than this are excluded
        -- Invalid category/actor strings reject with JSON-RPC -32602; a
        -- malformed `since` likewise rejects with -32602.
        -- These are feature-usage counters (which keybindings and MCP tools
        -- are exercised), NOT token counts. Per-call usage recording fires
        -- on every tools/call request.
        -- Handled by handle_query_usage in src/mcp/handlers/tasks/crud.rs.
}

rule DispatchTaskViaMcp {
    when: McpDispatchTask(task)

    requires: task.status = backlog

    ensures: DispatchTask(task)

    @guidance
        -- Returns an error if task.status != backlog.
        -- A single DispatchTask call covers both has_plan = true
        -- (with-plan prompt) and has_plan = false (brainstorm-or-plan
        -- prompt) variants — the prompt builder branches internally.
        -- dispatch_task is the only remaining MCP dispatch tool: it stays the
        -- explicit "dispatch this specific task" call, while epic chaining is
        -- automatic on a session close that takes effect
        -- (AutoDispatchNextSubtask in epics.allium, keyed on the SessionClosed
        -- that ExitSessionViaMcp withholds when its terminal write fails).
        -- Unlike that chain, this call is synchronous: it waits
        -- for worktree creation and agent launch to complete before returning.
        -- Its backlog guard is a claim, not a read: the backlog -> running
        -- transition is taken conditionally before provisioning starts, so a
        -- concurrent chain or TUI dispatch either loses to this call or beats it
        -- outright, and the task is never provisioned twice
        -- (DispatchClaimExclusive in dispatch.allium). A lost claim is reported
        -- as the same "not in backlog" error a task that was already running
        -- would produce, naming the status the task actually holds now.
        -- On success, the worktree path and tmux window are returned to the caller.
        -- On failure (e.g. worktree creation or tmux launch error), the error is
        -- returned immediately and the claim this call won is released, so the
        -- task is left in backlog status exactly as it was before the call. A call
        -- that never won the claim releases nothing.
}

rule SendMessageViaMcp {
    when: McpSendMessage(from_task, to_task, body)

    requires: from_task != null
    requires: to_task != null
    requires: to_task.worktree != null
    requires: to_task.tmux_window != null

    ensures: MessageDelivered(
        from: from_task,
        to: to_task,
        path: to_task.worktree + "/.claude-messages/" + from_task.id + "-" + timestamp_ms() + "-" + next_message_seq() + ".md"
    )
    ensures: TmuxNotificationSent(to: to_task, about: message_received)

    @guidance
        -- Inter-agent messaging. An agent writes a message file into the
        -- target agent's worktree under .claude-messages/, using a
        -- filename of `<from_task.id>-<unix_epoch_millis>-<seq>.md`, where
        -- `<seq>` is a process-wide monotonic counter incremented on every
        -- message-file write. The timestamp alone is not unique: two writes
        -- landing in the same millisecond (concurrent sends, or a watcher
        -- notification racing a send) would collide and the second write
        -- would silently overwrite the first. No caller parses the
        -- filename — it is passed back opaquely in the tmux nudge — so the
        -- counter segment is purely a uniqueness guarantee. The file
        -- contents begin with `[Message from task <id>: "<title>"]`
        -- followed by the body text.
        -- After writing the file, a tmux notification is injected via
        -- `tmux send-keys` telling the target to read and delete the
        -- file. If send-keys fails, the message file is removed and
        -- an error is returned to the caller.
        -- The TUI shows a brief envelope flash on the target task's card
        -- (message_flash tracking state, cleared after 3 seconds) via
        -- the MessageSent MCP event and the MessageReceived message.
        -- Both tasks must exist. The target must have an active worktree
        -- and tmux window (i.e. a running agent). The sender has no
        -- such constraint — it only needs to exist.
}

rule SubscribeToTaskViaMcp {
    when: McpSubscribeToTask(watcher_task, target_task)

    requires: watcher_task != null
    requires: target_task != null

    ensures: SubscribeToTask(watcher: watcher_task, target: target_task)

    @guidance
        -- subscribe_to_task(watcher_task_id, target_task_id) registers a
        -- one-shot watch: watcher_task is notified via a tmux-injected
        -- message once target_task reaches Done or Archived (or is deleted
        -- first). Both ids must resolve to existing tasks — an unresolved
        -- id is rejected the same way from_task_id/to_task_id are rejected
        -- in send_message.
        -- Self-watch rejection, the already_finished short-circuit, and
        -- idempotency on an existing unfinished (watcher, target) pair are
        -- all enforced by the underlying SubscribeToTask rule — see
        -- task-watchers.allium, which also owns the TaskWatcher entity this
        -- tool creates rows in.
        -- Handled by handle_subscribe_to_task in
        -- src/mcp/handlers/tasks/watch.rs.
}

rule UnsubscribeFromTaskViaMcp {
    when: McpUnsubscribeFromTask(watcher_task, target_task)

    requires: watcher_task != null
    requires: target_task != null

    ensures: UnsubscribeFromTask(watcher: watcher_task, target: target_task)

    @guidance
        -- unsubscribe_from_task(watcher_task_id, target_task_id) removes a
        -- specific (watcher, target) subscription; idempotent no-op if none
        -- exists — see the UnsubscribeFromTask rule in task-watchers.allium.
        -- Handled by handle_unsubscribe_from_task in
        -- src/mcp/handlers/tasks/watch.rs.
}

-- == CLI surface ==

rule AttachPlanViaCli {
    when: CliAttachPlan(task, path)

    requires: task != null

    ensures: task.plan_path = path

    @guidance
        -- CLI command: `dispatch plan <id> <path>` attaches a plan file to
        -- an existing task by writing task.plan_path directly via
        -- db.patch_task. No status transition occurs; the plan attachment
        -- is decoupled from dispatch.
        -- Implementation: src/main.rs Commands::Plan match arm.
        -- Used by the /queue-plan slash command (and operators) to stage
        -- a plan onto a task before dispatching it.
}

-- @guidance: Other CLI subcommands (operator/diagnostic surfaces; not
-- modeled as separate rules because they do not mutate task domain state
-- beyond what existing rules already cover):
--   • `dispatch tui [--port]` — primary entry point launching the TUI
--     (src/main.rs Commands::Tui). --port also reads the DISPATCH_PORT env
--     var and defaults to core/config.mcp_port.
--   • `dispatch list [--status <status>]` — diagnostic listing of tasks,
--     optionally filtered by status (src/main.rs Commands::List). Read-only.
--   • `dispatch setup [--port] [--yes]` — writes the Claude Code MCP
--     configuration (see CreateTaskViaMcp guidance for the headersHelper it
--     installs).
--   • `dispatch uninstall [--yes] [--purge]` — destructive: removes the
--     dispatch MCP configuration from Claude Code; with `--purge` also
--     deletes the database and log files (src/main.rs Commands::Uninstall).
--     Operator-only — never invoked by agents or hooks.
--   • `dispatch repo set-verify <path> <command>` /
--     `dispatch repo clear-verify <path>` / `dispatch repo list` — operator
--     equivalents of SetVerifyCommandViaMcp, writing the same
--     core/SavedRepoPath.verify_command. set-verify creates the path entry
--     when it does not exist yet.
--   • `dispatch prune-repo-paths` — drops core/SavedRepoPath rows whose path
--     no longer exists on the filesystem. Operator-only housekeeping.
--   • `dispatch update <id> <status> ...` — see HookNotification in agent-health.allium.
--   • `dispatch hook <id> <kind> [--kind K]` — see HookNotification in agent-health.allium.
--   • `dispatch pr-gate <id>` — see PrLearningsGate in pr-workflow.allium.
--   • `dispatch caller-headers` — see CreateTaskViaMcp guidance.
--   • `dispatch verify-feed <command>` — see VerifyFeed in feeds.allium.

-- == MCP Wrap-Up and Exit Tools ==

rule WrapUpViaMcp {
    when: McpWrapUp(task, action)

    requires: task.status = running or task.status = review
    requires: task.worktree != null

    -- All three actions leave task.status unchanged (still running/review) and
    -- only issue an exit token that records which action was requested. The
    -- terminal mutation (Done, or Review + pr-typed url) is deferred to the
    -- single ExitSessionViaMcp call. pr_url is no longer a wrap_up param — it
    -- travels with exit_session instead.
    ensures:
        if action = rebase:
            -- repo_path travels on the event because its consumer
            -- (RefreshRepoSyncStateAfterRebase in repo-sync.allium) needs the
            -- repository whose base branch just moved, and a branch name alone
            -- does not identify one.
            BranchRebased(
                branch: task.worktree.branch,
                onto: task.base_branch,
                repo_path: task.repo_path
            )
            issue_exit_token(task, rebase)
        else if action = done:
            issue_exit_token(task, done)
        else if action = pr:
            issue_exit_token(task, pr)

    @guidance
        -- wrap_up is the mandatory step before exit_session for ALL three
        -- actions (rebase, done, pr). It records action on the exit token
        -- (token.action) and returns that token in the response text; the
        -- agent must pass it back to exit_session.
        -- action="rebase" is the only action that does real synchronous work
        -- here: it runs the rebase / fast-forward (BranchRebased) via
        -- finish_task, which performs no session teardown, so the session
        -- stays alive until exit_session. action="done" and action="pr" perform no task-status
        -- or url mutation at wrap_up time — done no longer flips to Done, and
        -- pr no longer sets task.url or moves the task to review. Those
        -- mutations are applied later, atomically, by ExitSessionViaMcp. This
        -- removes the old asymmetry where done/pr mutated status inside
        -- wrap_up while rebase deferred to exit_session.
        -- The /wrap-up skill runs the /retro skill before its commit step,
        -- ahead of wrap_up, so any agent-context fix retro makes is committed
        -- with the session's work rather than stranded after the rebase.
        -- For the pr path the agent has already run git push and
        -- gh pr create by this point, and passes the resulting URL to
        -- exit_session (not to wrap_up).
        -- Handled by handle_wrap_up in src/mcp/handlers/tasks/wrap_up.rs.
}

rule ExitSessionViaMcp {
    when: McpExitSession(task, token, action, pr_url?)

    requires: exit_token_exists_for(task)
    requires: token = exit_token_value_for(task)
    requires: action = exit_token_action_for(task)
    requires: task.tmux_window != null
    requires:
        if action = pr: pr_url != null and pr_url != ""

    -- The terminal write — status, sub_status, url and the cleared
    -- tmux_window reference, applied as one patch — can fail at the
    -- persistence layer. Whether it took effect gates the terminal mutation,
    -- the tmux teardown and the SessionClosed emission below; only consuming
    -- the exit token happens either way. Same condition as ExitSession in
    -- pr-workflow.allium.
    let close_persisted = terminal_close_persisted(task)

    -- The window the teardown below names comes from the CLOSE OUTCOME — a
    -- fresh read of task.tmux_window taken immediately before the terminal
    -- patch, by the same call that applies it — not from task.tmux_window as
    -- read at the top of this rule, which a concurrent writer has a much wider
    -- window to have changed. The fresh read narrows that race to nothing but
    -- is still a separate read from the patch, not atomic with it. Same
    -- binding as ExitSession in pr-workflow.allium.
    let window = closed_session_window(task)

    ensures:
        consume_exit_token(task)
        -- The teardown is conditional on the same write as the terminal
        -- mutation, so a task whose close did not persist keeps both its live
        -- window and its tmux_window reference — the two can never disagree.
        if close_persisted:
            not exists window
            task.tmux_window = null
            if action = pr:
                task.status = review
                task.sub_status = core/SubStatus.default_for(review)
                task.url = core/TaskUrl{url: pr_url, url_type: pr}
            else:
                task.status = done
                task.sub_status = core/SubStatus.default_for(done)
                task.sort_order = completion_recency_rank(now)
            task.updated_at = now

    -- Emitted after the terminal mutation and after the task/epic-changed
    -- notifications have landed, so an epic chain keyed on it
    -- (AutoDispatchNextSubtask in epics.allium) sees the closed task in its
    -- terminal state. The tmux teardown is ISSUED before this point but is
    -- fire-and-forget: nothing waits for it, so its completion is not ordered
    -- against SessionClosed or against anything the chain then does.
    -- Conditional on the same write: a close that did not take effect must not
    -- chain.
    ensures:
        if close_persisted:
            SessionClosed(task: task)

    @guidance
        -- Single-call session close for all three wrap-up actions. The old
        -- two-phase behaviour (first call showed a reflection prompt and set
        -- token.reflected, second call closed) is gone: the mandatory
        -- reflection is now the /retro skill, which the /wrap-up skill runs
        -- BEFORE exit_session is ever called. With /retro as the forcing
        -- function, the in-handler reflected flag and first-call/second-call
        -- branch are removed.
        -- Validation, in the order the handler applies it (all mutate nothing
        -- on failure):
        --   • token must equal the token issued for this task, else "invalid
        --     exit token"; a missing token → "no exit token — call wrap_up
        --     first".
        --   • the supplied action must equal the action recorded on the token
        --     (exit_token_action_for). A missing action → "action is required".
        --     A mismatch (e.g. token issued for wrap_up(rebase) but the agent
        --     calls exit_session(action="pr")) is rejected with an error naming
        --     both actions.
        --   • task.tmux_window must be non-null. If already null, some other
        --     path already tore the session down; the handler reports "task
        --     #<id> has no active session" and the /wrap-up skill treats it as
        --     success. (On a normal double-close the token has also been
        --     consumed, so a retry hits the "call wrap_up first" branch above
        --     first.)
        --   • pr_url is required iff action = pr; it is rejected/ignored for
        --     rebase and done.
        -- Terminal mutation, applied atomically with clearing tmux_window and
        -- consuming the token:
        --   • rebase / done → task.status = done, task.sort_order =
        --                      completion_recency_rank(now) (applied by
        --                      close_session via
        --                      sort_order_for_status_transition, the same
        --                      completion-recency helper as tasks/ConfirmDone)
        --   • pr            → task.status = review, task.url = TaskUrl(pr_url,
        --                      url_type = pr) — this branch does not enter done,
        --                      so task.sort_order is untouched
        -- task/epic-changed is notified for all three actions; the underlying
        -- patch flow (src/service/tasks/crud.rs) triggers EpicStatusRecalculation
        -- on the parent epic. Handled by handle_exit_session in
        -- src/mcp/handlers/tasks/wrap_up.rs.
        -- When that terminal patch FAILS (close_persisted = false), the call is
        -- still a successful tools/call response, NOT a JSON-RPC error: the exit
        -- token has already been consumed by this point, so an error would
        -- strand the agent with no retry path. What changes is the response text
        -- — instead of the session-closed message (with or without a
        -- chained-subtask sentence) the response states that the task could not
        -- be moved to its terminal status, that the tmux session is still alive,
        -- names the task, and tells the agent the close needs redoing by hand.
        -- It must NOT claim the session was torn down, because it was not: the
        -- agent must not treat that response as a completed close.
        -- Everything else on that path: the failure is logged at warn, no
        -- kill-window is issued so the window survives and still hosts a live
        -- agent the human can attach to, the task keeps its status, sub_status,
        -- url and tmux_window (so it never satisfies is_detached and cannot
        -- drift into the awaiting-merge rendering), and SessionClosed is not
        -- emitted so no epic chain fires. ExitSession in pr-workflow.allium
        -- carries the full rationale, including the signals that were considered
        -- and rejected.
        -- Why the pr path closes the PR-merge race: a PR task never enters
        -- review with a pr-typed url until the exact same call that also nulls
        -- tmux_window, so PollPrStatus (which filters on status = review and
        -- url.url_type = pr) can never observe it mid-session.
        -- SessionClosed is emitted after the terminal patch and the
        -- task/epic-changed notifications, and only when that patch took
        -- effect. The kill-window teardown is issued just before it but is
        -- never awaited, so the window's death is not ordered against
        -- SessionClosed or the chain — it may land before or after. It is what
        -- drives automatic epic
        -- chaining (AutoDispatchNextSubtask in
        -- epics.allium), and it is fire-and-forget: a chain that stops, or
        -- fails, never turns a successful close into an error. All three
        -- actions emit it — for action = pr the finished work sits on a PR
        -- branch rather than base_branch, so the chained subtask still will not
        -- see it, but that is inherent to choosing the PR path rather than
        -- something this close does wrong. When a chain does fire, the response
        -- text names the subtask it dispatched; otherwise it is the plain
        -- session-closed message. There is no agent-facing tool to dispatch the
        -- next subtask — the tool description says so explicitly, so an agent
        -- reading tools/list does not go looking for one.
}

rule SetVerifyCommandViaMcp {
    when: McpSetVerifyCommand(repo_path, command?)

    -- A command may not span multiple lines; embedded newlines or
    -- carriage returns are rejected at the handler boundary. This
    -- upholds core's VerifyCommandSingleLine invariant before the value
    -- is ever stored.
    requires:
        if command != null:
            not (command.contains("\n") or command.contains("\r"))

    ensures: core/SavedRepoPath.created_or_updated(
        path: repo_path,
        verify_command: if command = null or is_blank(command): null else: command
    )

    @guidance
        -- set_verify_command stores (or clears) the verify command
        -- associated with a repo_path in saved_repo_paths.verify_command.
        -- A blank or whitespace-only command is normalised to null (clear)
        -- by the DB layer, matching the trait contract.
        -- A command containing "\n" or "\r" is rejected at the handler
        -- with JSON-RPC -32602 (invalid params) before reaching the DB,
        -- which would otherwise surface the constraint as -32603.
        -- Nothing nudges an agent to call this tool: exit_session carries no
        -- prompt about it, and wrap_up only echoes an already-recorded command
        -- back as its "Verify before exiting" line (see WrapUpRebase in
        -- pr-workflow.allium). Recording a verify command is an explicit act by
        -- an agent or operator (see the `dispatch repo set-verify` CLI above).
        -- Handled by handle_set_verify_command in
        -- src/mcp/handlers/tasks/verify.rs.
}
