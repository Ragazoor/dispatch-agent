-- allium: 3
-- split-pane.allium
--
-- Scope: Split-pane lifecycle, focus border, jump-to-agent, pin task,
--        swap, and tmux detach interactions.
-- Excludes: Task lifecycle (see tasks.allium); dispatch (see dispatch.allium);
--           PR/wrap-up (see pr-workflow.allium).

use "./core.allium" as core

given {
    split_pane: core/SplitPane
}

------------------------------------------------------------
-- Rules
------------------------------------------------------------

-- == Detach Tmux ==

rule DetachTmux {
    when: ConfirmDetachTmux(task)

    requires: task.tmux_window != null

    ensures: task.tmux_window = null
    ensures:
        if task.sub_status in {stale, crashed}:
            task.sub_status = core/SubStatus.default_for(task.status)

    @guidance
        -- Kills the tmux window for a task while preserving the
        -- worktree. The agent is gone but the branch remains for
        -- PR review or later resume. Clears agent health tracking
        -- (captured tmux output, crash detection). Only Stale/Crashed
        -- sub_statuses are reset to the default for the task's
        -- current status; all other sub_statuses are preserved.
        -- Allowed for any task with a tmux window: Running tasks
        -- have their live agent terminated; Review tasks lose their
        -- post-completion session. Triggered via the TUI (T key,
        -- uppercase). Always shows a confirmation prompt
        -- ("Detach tmux panel? [y/n]") before detaching, whether the
        -- target is a single task or a batch of multi-selected tasks.
}

rule BatchDetachTmux {
    when: BatchDetachTmux(tasks)

    -- Filters to tasks that have a tmux window, then detaches all.
    let detachable = tasks where tmux_window != null

    requires: detachable.count > 0

    ensures:
        for task in detachable:
            DetachTmux(task)

    @guidance
        -- Triggered via the TUI (T key, uppercase) when tasks are
        -- multi-selected. Shows a confirmation prompt with the count
        -- of detachable tasks ("Detach N tmux panels? [y/n]"). Tasks
        -- that lack a tmux window are silently
        -- filtered out before the prompt.
}

-- == Toggle Split Mode ([s] key) ==
--
-- [s] is the only way in or out of split mode; every other rule in this file
-- presupposes that split mode already exists. Entry auto-pins the selected
-- task when it has a live agent window, so a single [s] on a running or
-- reviewable task both opens the pane and pins that agent — no separate [S]
-- step is needed. Exit returns a pinned agent to a standalone tmux window:
-- the agent's session survives, only the split-pane UI goes away.

rule ToggleSplitMode {
    when: UserAction("s", task)

    ensures:
        if split_pane.active = true:
            ExitSplitMode()
        else if task.tmux_window != null:
            -- Auto-pin: the selected task's existing window is joined into
            -- the dispatch window as the right pane.
            split_pane.active = true
            split_pane.pane = task.tmux_window
            split_pane.pinned_task = task
            split_pane.focused = true
        else:
            -- No agent window to show: open a bare, unpinned shell pane.
            split_pane.active = true
            split_pane.pane = FreshShellPane()
            split_pane.pinned_task = null
            split_pane.focused = true

    @guidance
        -- Three-way branch on current state and the selection:
        --   1. Split active            -> exit (see ExitSplitMode).
        --   2. Inactive, selected task has a tmux window -> enter and pin it
        --      in one step via tmux join-pane.
        --   3. Inactive, no window (or no selection at all) -> enter with a
        --      fresh shell pane via tmux split-window.
        --
        -- Entry is best-effort: outside tmux it fails with a status hint
        -- ("Split mode requires tmux") and split mode stays inactive.
        -- focused resets to true on both entry and exit.
}

rule ExitSplitMode {
    when: ExitSplitMode()

    requires: split_pane.active = true
    requires: split_pane.pane != null

    let pinned = split_pane.pinned_task

    ensures: split_pane.active = false
    ensures: split_pane.pane = null
    ensures: split_pane.pinned_task = null
    ensures: split_pane.focused = true
    ensures:
        if pinned != null:
            -- The pinned agent is broken back out to a standalone tmux
            -- window under its original name. Its session is preserved.
            TaskWindowRestored(task: pinned, window: pinned.tmux_window)

    @guidance
        -- Exit destroys the split-pane UI, not the agent. With a task pinned,
        -- tmux break-pane returns the pane to a standalone window keyed by the
        -- task's tmux_window name, so the agent remains reachable via [Space].
        -- Only an unpinned (bare shell) pane is killed outright.
        --
        -- Emitted from two places: pressing [s] while split mode is active
        -- (ToggleSplitMode), and confirming quit — quitting dispatch with a
        -- task pinned restores that agent rather than ending its session.
}

-- == Split Pane Lifecycle ==
--
-- When a task lifecycle event clears or replaces a task's tmux window,
-- the split pane must be updated if that task is currently pinned.
-- The pane is never destroyed — its content is respawned as a fresh
-- shell so that split mode remains active without visual disruption.

rule SplitPaneRespawnOnWindowCleared {
    -- Fires whenever a lifecycle event clears a pinned task's tmux_window.
    -- The trigger is the clearing of task.tmux_window, not the specific
    -- event type. This covers all paths:
    --   - WrapUpRebase / FinishTaskSuccess (rebase completes → Done)
    --   - PrMerged (PR merged on GitHub → Done)
    --   - ConfirmDone (manual move into Done from any non-Done status)
    --   - ArchiveTask (any status → Archived)
    --   - RetryResume (old window killed, new dispatch starts)
    --
    -- NOT triggered by WrapUpPr — the tmux window stays alive after PR
    -- creation so the agent can continue working (e.g., self-review).
    -- NOT triggered by failure paths (FinishTaskConflict, PrFailed) —
    -- the pane should keep showing the agent session for inspection.

    when: task: core/Task.tmux_window transitions_to null
    requires: split_pane.active = true
    requires: split_pane.pinned_task = task

    ensures: split_pane.pinned_task = null
    ensures: split_pane.active = true
    ensures: split_pane.pane = RespawnedPane(split_pane.pane)

    @guidance
        -- The pane content is replaced in-place using tmux respawn-pane,
        -- which kills the current process and starts a fresh shell without
        -- destroying the pane itself. This avoids the flicker that would
        -- occur from a kill-then-recreate sequence.
        --
        -- Handlers that also emit KillTmuxWindow for the old window name
        -- are harmless — the window no longer exists as a standalone window
        -- (it was absorbed into the pane via join-pane), so the kill is a
        -- no-op. The respawn handles the actual cleanup.
        --
        -- If the pane was already closed externally, the respawn
        -- degrades gracefully to SplitPaneClosed (full reset).
}

-- == Split Pane Focus Border ==
--
-- When split mode is active, the TUI renders a thin border around its
-- entire area. The border color indicates whether the TUI pane has focus:
-- cyan when focused, dim when the agent pane has focus.
-- Requires tmux `focus-events on` for crossterm to receive focus events.

rule SplitPaneFocusBorder {
    when: SplitPaneRendered()

    requires: split_pane.active = true

    ensures: SplitPaneBorderRendered(focused: split_pane.focused)

    @guidance
        -- The border is only rendered during split mode. Normal single-pane
        -- usage has no border. FocusChanged events update split_pane.focused
        -- only when split is active — otherwise they are ignored.
        -- border_color = CYAN when split_pane.focused = true
        -- border_color = BORDER when split_pane.focused = false
}

-- == Jump to Agent Window / Activate Task (Space key) ==
--
-- Pressing Space on a task is the single "work on this task" action: it
-- jumps tmux focus to that task's agent window when one exists, and
-- otherwise starts or resumes the agent. This unifies the former Space
-- jump key with the now-removed [d] dispatch/resume key.
--
-- Priority order (first match wins):
--   1. Task pinned in the split pane   -> focus that pane.
--   2. task.tmux_window != null        -> jump to the window.
--   3. No window, routed by status     -> dispatch / resume / retry / hint.
--
-- The window check (2) precedes the status check (3), so a Stale or Crashed
-- task that still has a window is jumped to (a stale agent is usually just
-- idle) rather than opening the retry dialog. The retry dialog is reached
-- only for a windowless Stale/Crashed task (3).

rule JumpToAgentWindow {
    when: UserAction(" ", task)

    ensures:
        if split_pane.active = true and split_pane.pinned_task = task:
            -- Priority 1: the task is pinned; its window was joined into the
            -- dispatch window via join-pane, so focus the pane directly.
            tmux_focus = split_pane.pane
        else if task.tmux_window != null:
            -- Priority 2: jump to the standalone agent window.
            tmux_focus = task.tmux_window
        else if task.status = backlog:
            -- Priority 3, Backlog: start the agent. Repo-trust confirmation
            -- (ConfirmTrustRepo) is preserved as a pre-dispatch gate.
            DispatchTask(task)
        else if task.status in {running, review, done}:
            if task.sub_status in {stale, crashed}:
                -- Windowless Stale/Crashed: open the kill-and-retry dialog.
                ConfirmRetry(task)
            else if task.worktree != null:
                -- Worktree survives, no live window: reattach the agent.
                ResumeTask(task)
            else:
                UserInformed(about: no_worktree_to_resume, task: task)
        else:
            -- Archived.
            UserInformed(about: task_archived, task: task)

    @guidance
        -- Space is the unified activate action. The branches, in priority
        -- order:
        --
        --   1. Pinned in the split pane: the task's pane has been joined into
        --      the dispatch window via join-pane and the original standalone
        --      window no longer exists, so this calls tmux select-pane on
        --      split_pane.right_pane_id rather than select-window.
        --
        --   2. Has a tmux window: the normal jump (no split, or split active
        --      but a different task is pinned) calls tmux select-window on
        --      task.tmux_window. This branch also covers Stale/Crashed tasks
        --      that still have a window — the window check wins over the
        --      problematic-status check, because a stale agent is usually just
        --      idle and jumping to it is what the user wants.
        --
        --   3. No window, routed by status:
        --      * Backlog        -> DispatchTask (dispatch.allium). The
        --        repo-trust confirmation (ConfirmTrustRepo) is preserved: an
        --        untrusted repo first shows the trust prompt, which on accept
        --        proceeds to dispatch. The gate itself is specified in
        --        dispatch.allium (DispatchTask, "Repo-trust pre-gate"), and
        --        quick dispatch goes through the same gate via
        --        QuickDispatchTrustGate in tasks.allium.
        --        Tag-based routing (research ->
        --        DispatchResearchTask) lives in dispatch.allium, not here.
        --      * Running/Review/Done, Stale or Crashed -> open the
        --        kill-and-retry dialog (ConfirmRetry: [r] resume / [f] fresh
        --        start). This is the only path that still opens that dialog
        --        (RetryResume / RetryFresh in dispatch.allium).
        --      * Running/Review/Done with a worktree -> ResumeTask
        --        (dispatch.allium): reattach the agent in the existing
        --        worktree.
        --      * Running/Review/Done without a worktree -> a status hint
        --        ("No worktree to resume, move to Backlog and re-dispatch").
        --      * Archived -> a status hint ("Task is archived").
        --
        -- Space on an epic row (board view) is unchanged: it enters the epic
        -- view. Inside the epic, Space on each subtask follows the task rules
        -- above.
        --
        -- Contrast with [S], which peeks at the window in-place without
        -- transferring focus.
}

-- == Jump Back to TUI Window (Prefix+Space) ==
--
-- The complement of [Space]: while focus is on an agent's tmux window,
-- pressing the tmux prefix followed by Space jumps tmux focus back to the
-- dispatch TUI window.

rule JumpBackToTuiWindow {
    when: UserAction("prefix+space")

    ensures: tmux_focus = "TUI"

    @guidance
        -- Registered at TUI startup as a prefixed tmux keybinding (the tmux
        -- prefix must be pressed first, same as any other tmux binding):
        --   tmux bind-key space "select-window -t =TUI"
        -- The TUI window is renamed to the fixed "TUI" constant at startup so
        -- the binding can target it by name. Both the binding and the rename
        -- are torn down on exit (unbind-key space; rename restored).
        --
        -- The leading "=" anchors the target to an exact name match: tmux
        -- otherwise resolves a name target by prefix, so a window merely
        -- *starting* with "TUI" could absorb the jump (see the
        -- TmuxWindowTargetedExactly invariant in dispatch.allium). This is the
        -- one window target that cannot be resolved to a pane identity up
        -- front, because the binding is a command tmux runs later and any pane
        -- identity captured at registration time would be stale by then.
        --
        -- Implemented in src/runtime/mod.rs (setup_tmux_for_tui /
        -- teardown_tmux_for_tui) via tmux::bind_key / unbind_key.
        -- Best-effort: a failing tmux call does not prevent the TUI starting.
        --
        -- Surfaced in the in-TUI help popup ([?], General section) alongside
        -- the agent-tree toggle (see agent-tree.allium's
        -- BindAgentTreeToggle) so both tmux-global bindings are discoverable
        -- without leaving the board.
}

-- == Pin Task in Split Pane ([S] key) ==
--
-- Pressing [S] on a task in split mode pins that task's tmux window into the
-- right pane without transferring tmux focus. The user stays on the TUI board.
-- Outside split mode [S] shows a hint ("Split view not active — press s to open").

rule PinTaskInSplitPane {
    when: UserAction("S", task)
    requires: split_pane.active = true
    requires: task.tmux_window != null

    ensures: split_pane.pinned_task = task
    ensures: split_pane.pane = task.tmux_window
    ensures: split_pane.focused = unchanged  -- focus does NOT transfer

    @guidance
        -- When the selected task is already pinned, the action is a no-op.
        -- When a different task is pinned, the pane content is swapped in-place
        -- via tmux swap-pane. The old content is returned to a standalone window.
        --
        -- No tmux select-pane is called — the TUI pane retains focus throughout.
        -- [g] (lowercase) is the complementary "take over the window" action.
        --
        -- Outside split mode [S] shows a status hint ("Split view not active —
        -- press s to open") and emits no split commands.
        --
        -- == IMPLEMENTED: companion-pane draining ==
        -- The empty-pane case (no task currently pinned) reaches this via
        -- `exec_enter_split_mode_with_task` (src/runtime/split.rs), which
        -- calls `tmux::join_pane` (src/tmux.rs) to move only the agent's own
        -- (active) pane out of its window. If that window also carries an
        -- agent-tree companion pane (docs/specs/agent-tree.allium), the
        -- companion is now the window's sole remaining pane —
        -- indistinguishable, from live tmux state alone, from the companion
        -- being toggled hidden. `exec_enter_split_mode_with_task` captures
        -- the companion pane's ID (via `tmux::inactive_pane_id`) *before*
        -- calling `join_pane` and kills it once the join succeeds, so the
        -- source window is fully drained either way, restoring the "the
        -- window no longer exists" assumption
        -- `SplitPaneRespawnOnWindowCleared`'s guidance relies on. Both the
        -- check and the kill are best-effort: a failure is logged, never
        -- propagated, since the companion pane is decorative. `join_pane`
        -- itself stays a plain tmux wrapper with no companion-pane
        -- awareness — that orchestration lives at the call site, alongside
        -- the equivalent resync in SwapSplitPane's guidance below. Resolves
        -- agent-tree.allium's ToggleVsSplitPaneInteraction open question for
        -- the join half of the gap.
}

rule SwapSplitPane {
    when: UserAction("S", task)
    requires: split_pane.active = true
    requires: task.tmux_window != null
    requires: split_pane.pinned_task != task  -- no-op when already pinned

    ensures:
        if split_pane.pinned_task != null:
            -- Swap: the currently pinned task's pane is returned to a
            -- standalone window, and the new task's window is joined
            -- into the split pane.
            SplitPaneSwapped(
                new_task: task,
                old_task: split_pane.pinned_task
            )
        else:
            SplitPanePinned(task: task)
    ensures: split_pane.pinned_task = task
    ensures: split_pane.pane = task.tmux_window

    @guidance
        -- This rule specifies the swap case for [S]; the pin-empty case
        -- is covered by PinTaskInSplitPane. When the pane already holds
        -- a different task's window, the old window is swapped out via
        -- tmux swap-pane and returned to the standalone window list.
        -- tmux focus is NOT transferred — the TUI pane retains focus
        -- throughout the swap.
        --
        -- == IMPLEMENTED: companion-pane resync ==
        -- `exec_swap_split_pane` (src/runtime/split.rs) uses `swap-pane` to
        -- atomically exchange pane *content* between the previously-pinned
        -- task's pane and the new task's pane 0 — panes keep their window
        -- membership; only the running process each one displays changes.
        -- It then renames the window (formerly the new task's) to the old
        -- task's window name. Neither step touches pane 1: a renamed
        -- window's agent-tree companion pane (docs/specs/agent-tree.allium),
        -- if any, keeps running `dispatch agent-tree <new_task_id>` under a
        -- window now named (and considered to belong to) the old task —
        -- silently rendering the wrong agent's tree.
        --
        -- After a successful rename, `dispatch::resync_agent_tree_pane`
        -- (src/dispatch/agents.rs) parses the task id back out of the
        -- window's own new name (the same `task-<id>` inverse
        -- `toggle_agent_tree_pane` already uses) and, if the window carries
        -- a companion pane, kills it and relaunches
        -- `dispatch agent-tree <task_id>` for that correct task. A no-op for
        -- a non-task window name or a window with no companion pane at all.
        -- Best-effort throughout: failures are logged, never propagated.
        --
        -- The `old_task = null` branch (no previously-pinned task) needs no
        -- equivalent fix: `tmux::kill_window` there destroys the whole
        -- window, companion pane included, so nothing is left to desync.
        -- Resolves agent-tree.allium's ToggleVsSplitPaneInteraction open
        -- question for the swap half of the gap.
}

-- == Splits Inside an Agent Window Start in the Task's Worktree ==
--
-- Distinct from the board's own split pane above: this is about any new pane
-- created *inside* an agent's tmux window — by the user pressing a tmux split
-- binding, or by dispatch itself opening the agent-tree companion pane (see
-- agent-tree.allium: SplitAgentTreePaneOnAgentLaunch).
--
-- Whoever caused the split, the new pane must start in that task's worktree.
-- The correction is delivered to the newly created pane and to no other pane.
-- Any other target is a correctness bug, not a cosmetic imprecision: the board
-- TUI and the agent's own Claude session both interpret keystrokes as input.

rule AgentWindowSplitStartsInTaskWorktree {
    when: TmuxWindowSplit(window, new_pane)

    -- The window being split is a dispatched task's agent window.
    let task = core/Task{tmux_window: window}

    requires: exists task
    requires: task.worktree != null

    ensures: PaneWorkingDirectorySet(
        pane: new_pane,
        directory: task.worktree.path
    )

    @guidance
        -- Mechanism. Each agent window carries its worktree path in a
        -- per-window tmux user option, @dispatch_dir, set when the window is
        -- created. A single session-level after-split-window hook tests whether
        -- the split window has @dispatch_dir set and, if so, sends `cd <that
        -- dir>` + Enter to the new pane. The hook must name its target
        -- explicitly (send-keys -t #{pane_id}): inside run-shell -bC the target
        -- context is lost and tmux falls back to the session's *active* pane,
        -- which during a background split is whatever the user is looking at —
        -- typically the board. An untargeted send-keys therefore typed
        -- `cd <worktree>` into the kanban board, where `c` fired the Copy-Task
        -- binding and the remainder landed in the resulting text field.
        --
        -- This mechanism is load-bearing and cannot simply be deleted. tmux
        -- does not give worktree-relative splits for free: for a split-window
        -- invoked by an external CLI client — which is how dispatch, or any
        -- script, shells out to tmux — tmux resolves the new pane's start
        -- directory from the *invoking client's* cwd, not from the pane being
        -- split. Verified empirically. Without the option-plus-hook every split
        -- inside an agent window lands in the dispatch process's cwd. That was
        -- issue #231, fixed by commit 8bf36803, which replaced an earlier
        -- unconditional session-level hook (all splits landed in the most
        -- recently dispatched worktree) with the per-window @dispatch_dir option
        -- plus conditional hook described here. Any future refactor that removes
        -- the hook must first replace this guarantee by other means.
        --
        -- Accepted side effect. Dispatch's own agent-tree companion pane is
        -- created by splitting the agent window, so it receives these
        -- keystrokes too. That pane treats Space and Enter as "toggle selected
        -- node", so the `cd` line produces two cancelling toggles and no net
        -- state change. This is knowingly accepted as cosmetic, not overlooked.
}

------------------------------------------------------------
-- Invariants
------------------------------------------------------------

-- SplitDirectoryTargetsNewPaneOnly: The worktree `cd` that follows a split
-- inside an agent window is delivered to the newly created pane and to no
-- other pane — never to the board TUI pane, and never to the agent's own
-- Claude pane. Both of those consume keystrokes as user input, so a mistargeted
-- delivery is an unintended command, not a harmless echo.

-- SplitPaneStability: When split mode is active, the pane must never be
-- destroyed and recreated in response to task lifecycle events. Pane content
-- is replaced in-place (respawn) to avoid visual flicker. The only operations
-- that tear down the pane are explicit user actions: toggling split mode off
-- (s key) or manually closing the pane. Even then it is the split-pane UI that
-- is torn down, not the agent: ExitSplitMode breaks a pinned task's pane back
-- out to a standalone tmux window and only kills the pane when nothing was
-- pinned. Lifecycle events (finish, PR creation) respawn the pane content and
-- clear pinned_task, but keep active=true and pane intact.
