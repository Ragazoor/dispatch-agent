-- allium: 3
-- core.allium
--
-- Scope: Shared domain model for the dispatch system
-- Includes: External entities, enumerations, core entities, config, VisualColumn and FlattenedView concepts
-- Excludes: Rules, invariants (see tasks.allium, dispatch.allium, agent-health.allium,
--           pr-workflow.allium, split-pane.allium, mcp-task-tools.allium, epics.allium,
--           learnings.allium)

------------------------------------------------------------
-- External Entities
------------------------------------------------------------

-- The git worktree and tmux window are provisioned externally.
-- The spec treats them as opaque handles.

external entity Worktree {
    path: String
    branch: String
}

external entity TmuxWindow {
    name: String
}

external entity TmuxPane {
    id: String       -- tmux pane identifier (e.g., "%42")
}

------------------------------------------------------------
-- Enumerations
------------------------------------------------------------

enum TaskTag { bug | feature | chore | pr_review | research | fix | dependabot }

-- UrlType classifies the single URL attached to a Task (see TaskUrl).
-- The type is stored explicitly rather than guessed from the URL string at
-- render time. Only pr-typed urls are polled for PR merge/close (see
-- pr-workflow.allium: PollPrStatus).
enum UrlType { pr | security_alert | issue | other }

-- FeedRole is the routing role of an epic within a PR-review feed hierarchy.
-- `none` is the default for ordinary epics; the other roles tag a sub-epic as a
-- destination bucket for PR items routed by feed signals (see feeds.allium: Signal).
enum FeedRole { none | reviews_parent | my_reviews | team_reviews | bots | cve }

-- EpicOrigin records how an epic came into existence.
-- `manual` is the default for epics created by the user or via MCP.
-- `repo_group` is set by the system when a per-repo sub-epic is created
-- automatically by repo grouping (see epics.allium: RegroupEpic /
-- service::grouping). This field is system-assigned and is never exposed
-- to MCP callers.
enum EpicOrigin { manual | repo_group }

-- Legacy alias: "ready" maps to backlog
enum TaskStatus { backlog | running | review | done | archived }

-- SubStatus refines the parent status into a more precise state.
-- Valid combinations are constrained by SubStatus.is_valid_for(status).
-- When status changes, sub_status resets to SubStatus.default_for(new_status).
enum SubStatus {
    -- backlog / done / archived
    none

    -- running (and review where noted)
    active          -- agent is running normally
    needs_input     -- agent is blocked waiting for human interaction (Blocked visual column)
    stale           -- no PreToolUse hook event seen for longer than inactivity_timeout (time since last_pre_tool_use_at)
    crashed         -- tmux window disappeared unexpectedly
    conflict        -- rebase/merge encountered a conflict (valid for both running and review)

    -- review
    awaiting_review   -- PR created, no review decision yet
                      -- UI splits this into two visual sections based on runtime state:
                      --   "awaiting review" — tmux window alive (agent still active)
                      --   "awaiting merge"  — tmux window gone (detached, just waiting for merge)
    changes_requested -- reviewer requested changes
    approved          -- PR approved, ready to merge
}

-- Valid SubStatus values per parent status (enforced in the DB by a CHECK
-- constraint and in-code via SubStatus.is_valid_for):
--   backlog   : none
--   running   : active | needs_input | stale | crashed | conflict
--   review    : awaiting_review | changes_requested | approved | conflict
--   done      : none
--   archived  : none
--
-- Note: HookNotification only fires when task.status = running, setting
-- sub_status = needs_input. The resulting (running, needs_input) state
-- renders as the "Blocked" visual column. Legacy (review, needs_input)
-- rows from older hook behaviour were normalised to (review, awaiting_review)
-- by migration v16.

-- Default sub_status when transitioning to a new status:
--   backlog   -> none
--   running   -> active
--   review    -> awaiting_review
--   done      -> none
--   archived  -> none

-- NotificationKind is the `notification_type` field on Claude Code's Notification
-- hook payload, forwarded by the task-status-hook as the `--kind` argument to
-- `dispatch hook <id> notification`. It is absent on Claude Code versions that
-- predate the field. The agent-view-only values `agent_needs_input` and
-- `agent_completed` are intentionally excluded: dispatch runs a plain `claude`
-- process in tmux, never `claude agents`, so those values never reach the hook.
-- See HookNotification in agent-health.allium for how each value is classified.
enum NotificationKind {
    permission_prompt       -- agent is blocked on a permission decision
    idle_prompt             -- agent has gone idle awaiting human input
    auth_success            -- informational (auth succeeded); not human-actionable
    elicitation_dialog      -- agent is asking a question / showing a form
    elicitation_complete    -- an elicitation just resolved
    elicitation_response    -- an elicitation response was received
}

-- LearningScope identifies what context a learning applies to.
-- Dispatch retrieval unions: user + repo:<this_repo> + epic:<this_epic> (if set).
-- task scope carries task-specific outcomes, retrieved on demand.
enum LearningScope { user | repo | epic | task }

-- LearningKind categorises what was learned. kind does not affect retrieval or
-- rendering: every retrieved entry, procedural included, goes into the single
-- RAG-ranked "Validated knowledge" block (see learnings.allium: Priority
-- Ordering). kind describes how an entry was authored and what it means.
enum LearningKind {
    pitfall              -- a failure mode; agents should avoid or handle carefully
    convention           -- preferred code pattern or style in this context
    preference           -- the user's explicit working preference
    tool_recommendation  -- recommended tool or library for a given problem
    procedural           -- a how-to-work-here procedure; injected like any other kind
    landscape            -- codebase/system overview (service maps, module responsibilities)
}

-- LearningStatus controls whether an entry is active in retrieval.
-- New entries land as approved; there is no human approval gate and no human
-- curation surface. A background job archives stale, unvalued entries (see
-- learnings.allium: ArchiveStaleLearning), which is the only status change any
-- behaviour produces. rejected is legacy: nothing produces it any more, but
-- existing rows still hold it. Entries in rejected or archived are excluded from
-- prompt injection and query_learnings results.
enum LearningStatus { approved | rejected | archived }

-- VerdictKind captures an agent's evaluation of a retrieved learning, submitted
-- via the rate_learning MCP tool at any point during a task. Both verdicts adjust
-- the learning's net score; neither changes its status.
--   helped  — the learning applied and was useful (an upvote: upvote_count + 1)
--   wrong   — the learning misled the agent or is no longer accurate
--             (a downvote: upvote_count - 1, may go negative)
enum VerdictKind { helped | wrong }

-- RetrievalSource records how a learning was surfaced to a task's agent.
--   prompt_injection — included in the single RAG-ranked "Validated knowledge"
--                      block prepended to the dispatch prompt
--   procedural       — legacy; no longer produced. Procedural learnings are now
--                      injected as part of the unified prompt_injection block
--                      (see learnings.allium). Retained for existing DB records.
--   query_learnings  — returned by an explicit query_learnings MCP call
enum RetrievalSource { prompt_injection | procedural | query_learnings }

-- WrapUpMode records the preferred wrap-up path for a task, set at creation
-- time by the user or agent. When set, the /wrap-up skill honours it instead
-- of prompting the user.
--   rebase — rebase the task branch onto base_branch and fast-forward it
--   pr     — agent authors and creates a draft PR (no git ops done by dispatch)
--   done   — close without any git operations; task moves to Done directly
enum WrapUpMode { rebase | pr | done }

------------------------------------------------------------
-- Storage Boundary Validation
------------------------------------------------------------

-- Any entity read from storage whose enum fields contain an unrecognised
-- string value must fail the read operation with an error rather than
-- silently defaulting to a fallback variant.
--
-- Rationale: silent defaults mask data-integrity bugs (corrupt migrations,
-- manual DB edits, schema drift) and produce subtly wrong in-memory state
-- that is hard to trace back to the real cause. A hard read error surfaces
-- the problem immediately. The TUI and MCP error-display paths already
-- handle DB errors gracefully, so a hard error is safe.
--
-- This applies to all enum columns: TaskStatus, SubStatus, TaskTag,
-- WrapUpMode, LearningKind, LearningScope and LearningStatus.
-- It also applies to JSON-encoded columns (e.g. labels, tags): malformed
-- JSON must return an error rather than an empty list.
--
-- Exception: FeedRole and EpicOrigin soft-fail instead. An unrecognised
-- value in either column logs a warning and defaults to FeedRole.none /
-- EpicOrigin.manual rather than failing the read.
--
-- Rationale: these two are additive, system-assigned routing/provenance
-- tags. New roles/origins are appended over time, and a newer binary may
-- write a value an older binary has never heard of. Hard-failing would
-- make an older binary reject rows it could otherwise display perfectly
-- well, so it degrades gracefully to the default tag instead. The default
-- is the safe, neutral choice in both cases: `none` (ordinary epic, no feed
-- routing) and `manual` (no special provenance). Because the value is
-- system-assigned and never user-supplied, an unknown value signals a
-- forward-compatibility gap, not the data-integrity bug the hard-fail rule
-- guards against.

------------------------------------------------------------
-- Entities and Variants
------------------------------------------------------------

-- TaskUrl is the single typed URL attached to a Task. The url_type is stored
-- explicitly (not inferred from the string at render time), so the system
-- knows whether the URL is a PR, security alert, issue, or something else.
value TaskUrl {
    url: String
    url_type: UrlType
}

entity Task {
    title: String
    description: String
    repo_path: String
    status: TaskStatus
    sub_status: SubStatus
    worktree: Worktree?
    tmux_window: TmuxWindow?
    plan_path: String?    -- filesystem path to the implementation plan file
    epic: Epic?
    url: TaskUrl?    -- subsumes the former pr_url: the single typed URL attached to this task
    tag: TaskTag?
    sort_order: Integer?  -- shared namespace for feed-driven and user-set ordering; lower sorts first via COALESCE(sort_order, id) ASC
    labels: List<String> = []  -- free-form badges rendered on the card's second line; set by feed scripts via FeedItem.labels or by future TUI editors.
                               -- Ordered, and the order is load-bearing: badges render in
                               -- declaration order so a feed script controls which label
                               -- appears first on the card. Duplicates are retained.
    base_branch: String = "main" -- the branch this task rebases onto / targets for PRs
    external_id: String?  -- stable identifier for tasks sourced from a feed epic (see feeds.allium); null for hand-created tasks. Unique per (epic, external_id) when set.
    last_pre_tool_use_at: Timestamp?  -- wallclock of the most recent PreToolUse hook; null when the agent has never tooled (or after Stop)
    last_notification_at: Timestamp?  -- wallclock of the most recent Notification hook; null when no notification is pending (or after Stop)
    live_subagents: Integer = 0  -- count of subagents currently executing for this task; a denormalised count of SubagentEntry rows, rewritten alongside every mutation and clear point (see agent-health.allium)
    stop_pending: Boolean = false  -- a Stop hook arrived while subagents were live; flip to review once they drain (see agent-health.allium: HookStop / HookSubagentStop). Cleared by any status write that leaves running — see PendingStopOnlyWhileRunning below
    stop_pending_at: Timestamp?  -- when the Stop that stop_pending defers actually fired (the hook's event time, not its write time). Meaningful only while stop_pending holds; the clear points leave it alone because every reader gates on the bit. HookUserPromptSubmit compares against it to tell a Stop deferred by an earlier turn from one deferred by the turn now starting — see its guidance. Null while the bit is set means the Stop predates the field, and reads as "fired before any prompt"
    pr_learnings_gate_shown_at: Timestamp?  -- set once when the PrLearningsGate fires; null means the gate has never fired for this task
    wrap_up_mode: WrapUpMode?  -- preferred wrap-up path; null means decide at wrap-up time
    auto_run_plan: Boolean = false  -- when true and plan_path is set, build_prompt's
                                    -- has-plan addendum skips asking the dispatched
                                    -- agent to confirm before implementing (see
                                    -- dispatch.allium's build_prompt guidance)
    created_at: Timestamp
    updated_at: Timestamp

    transitions status {
        backlog -> running
        running -> review
        running -> backlog
        -- The archive key ('x') completes a task from wherever it sits, so
        -- Done is reachable directly from backlog and running, not only
        -- from review (see tasks.allium: ConfirmDone / ArchiveKeyRouting)
        backlog -> done
        running -> done
        review -> done
        review -> running
        done -> review
        done -> running
        done -> archived
        -- Archive is accepted from any non-archived status
        backlog -> archived
        running -> archived
        review -> archived
        terminal: archived
    }
    -- This graph governs the move-based status changes only (MoveTask,
    -- ConfirmDone, Archive, dispatch/PR-driven transitions). Three
    -- operator paths are intentionally exempt from it:
    --   - EditTask, the tmux task editor (see tasks.allium: EditTask) —
    --     reachable from the archive view as well as the main board. May
    --     set any TaskStatus from any other, including moving a task
    --     back out of the terminal `archived` state.
    --   - `dispatch update <id> <status>`, the CLI operator path
    --     (see task-watchers.allium). Same unrestricted range.
    --   - MCP `update_task` (see mcp-task-tools.allium:
    --     UpdateTaskViaMcp), the agent path. Partially restricted: it
    --     refuses `done` and `archived` as TARGET statuses, but applies
    --     no edge check at all beyond that, and does not constrain the
    --     SOURCE status. So an agent can drive `review -> backlog`,
    --     `backlog -> review` and `done -> backlog` — none declared
    --     above — and can also leave the terminal `archived` state for
    --     backlog/running/review, since only the target is checked.
    -- All three are deliberate escape hatches — manual correction for
    -- the first two, re-opening or re-queueing work for the third — not
    -- edges of the lifecycle, so they are not declared above. Every
    -- other status change, whether automatic or a keyboard move, does
    -- obey the graph.

    -- Derived
    has_plan: plan_path != null
    is_stale: sub_status = stale
    is_crashed: sub_status = crashed
    is_detached: worktree != null and tmux_window = null
                 and status in {running, review}
                 and sub_status != conflict
    -- A task that looks live but was never provisioned (or lost its
    -- provisioning), so there is nothing to resume. Mutually exclusive with
    -- is_detached, which requires a worktree — but not its complement: a
    -- running task with a worktree, no window and sub_status = conflict is
    -- neither.
    -- Surfaced on the card by UnprovisionedIndicator in dispatch.allium.
    is_unprovisioned: worktree = null and tmux_window = null
                      and status in {running, review}
    -- pr_number is parsed from the trailing numeric segment of url.url, but
    -- only when the url is pr-typed; otherwise null. Not persisted; computed
    -- on demand.
    pr_number: if url != null and url.url_type = pr: pr_number_from_url(url.url) else: null

    -- live_subagents is a denormalised count of this task's SubagentEntry
    -- rows (see SubagentEntry below); every mutation and clear point
    -- rewrites both in the same write, so they cannot disagree (see
    -- agent-health.allium: HookSubagentStart / HookSubagentStop and the
    -- four clear points documented there).
    invariant LiveSubagentCountMatchesEntries {
        live_subagents = (SubagentEntries where task = this).count
    }

    -- A deferred Stop belongs to the turn the task was running when it
    -- arrived. Only HookStop sets the bit, and it requires status =
    -- running; every status write that leaves running clears it in the
    -- same write (MoveTaskForward / MoveTaskBackward / ConfirmDone /
    -- ArchiveTask in tasks.allium, UpdateTaskViaMcp in
    -- mcp-task-tools.allium, ExitSession in pr-workflow.allium, and the
    -- drain points in agent-health.allium). So the bit cannot outlive the
    -- status it was recorded under, and cannot be waiting for a task that
    -- a later move puts back into running — where the next drain would
    -- otherwise flip it straight back out of a status a human just chose.
    invariant PendingStopOnlyWhileRunning {
        stop_pending implies status = running
    }
}

-- A live subagent, as reported by the SubagentStart/SubagentStop Claude
-- Code hooks. The table is the authority for Task.live_subagents, which
-- is a denormalised count rewritten from it by every mutation and clear
-- point (see agent-health.allium). started_at is retained for diagnostics
-- only; no rule branches on it.
entity SubagentEntry {
    task: Task
    agent_id: String
    session_id: String
    started_at: Timestamp
}

entity Epic {
    title: String
    description: String
    status: TaskStatus
    plan_path: String?    -- filesystem path to the implementation plan file
    sort_order: Integer?
    auto_dispatch: Boolean = false
    parent: Epic?         -- null for root epics; set for nested sub-epics
    feed_command: String?           -- shell command that emits FeedItem JSON (see feeds.allium); null for non-feed epics
    feed_interval_secs: Integer?    -- per-epic poll cadence in seconds; null falls back to config.default_feed_interval
    group_by_repo: Boolean = false      -- when true, feed tasks are grouped into sub-epics by repo name (see feeds.allium)
    feed_role: FeedRole = none      -- routing role within a feed hierarchy; `none` for ordinary epics (see feeds.allium: Signal)
    origin: EpicOrigin = manual    -- system-assigned; never settable via MCP
    created_at: Timestamp
    updated_at: Timestamp

    has_plan: plan_path != null
    is_root: parent = null
    is_feed: feed_command != null

    -- DB-level invariant from migration v65: at most one sub-epic per
    -- (parent, feed_role) when feed_role != none. Ordinary epics
    -- (feed_role = none) are exempt — any number may share a parent.
    -- Enforced in the DB by a partial unique index on (parent_id, feed_role)
    -- WHERE feed_role != 'none'.
    invariant UniqueFeedRolePerParent {
        for a in Epics:
            for b in Epics:
                a != b and a.feed_role != none and a.parent = b.parent
                    implies (a.feed_role != b.feed_role or b.feed_role = none)
    }

    -- DB-level invariant: at most one sub-epic per (parent, title) when
    -- origin = repo_group. Enforced by a partial unique index on
    -- (parent_id, title) WHERE origin = 'repo-group'. Ordinary epics
    -- (origin = manual) are exempt — any number may share a title.
    invariant UniqueRepoGroupPerParent {
        for a in Epics:
            for b in Epics:
                a != b and a.origin = repo_group and a.parent = b.parent and a.title = b.title
                    implies b.origin != repo_group
    }

    subtasks: Task with epic = this
    active_subtasks: subtasks where status != archived
    subtask_statuses: active_subtasks -> status

    sub_epics: Epic with parent = this
    active_sub_epics: sub_epics where status != archived

    -- Heterogeneous set used for status recalculation and dispatch ordering.
    -- Combines active tasks and active sub-epics; each element contributes
    -- its .status value to the parent's recalculated status.
    active_children: active_subtasks + active_sub_epics
}

entity SavedRepoPath {
    path: String             -- filesystem path, unique across all saved paths
    last_used: Timestamp     -- updated on each use; drives recency ordering
    verify_command: String?  -- single-line shell command run by agents before declaring work complete, e.g. "cargo test"

    invariant VerifyCommandSingleLine {
        verify_command = null or not (verify_command.contains("\n") or verify_command.contains("\r"))  -- short-circuits: rhs only evaluated when verify_command != null
    }
}

-- SavedRepoBranch records a base_branch that was used for a given repo_path,
-- forming a per-repo most-recently-used history that feeds the base-branch
-- fuzzy picker during manual task creation (see dispatch.allium:
-- RecordBaseBranch, BaseBranchPicker). This is a dedicated settings-style
-- table (repo_base_branches), a sibling of SavedRepoPath's repo_paths table —
-- and, like the per-repo verify_command setting, a per-repo setting keyed by
-- repo_path.
--
-- It is deliberately NOT derived from Task.base_branch, so that:
--   (a) only branches entered through the manual new-task form are
--       remembered — quick-dispatch and MCP-created branches are excluded
--       (see the recording-scope decision in dispatch.allium: RecordBaseBranch);
--   (b) a remembered branch does not vanish when the task that used it is
--       later deleted.
--
-- Identity is the (repo_path, branch) pair: at most one row per branch per
-- repo. Recency ordering (most-recent-first) and the per-repo cap are
-- governed by the write operation (see dispatch.allium: RecordBaseBranch and
-- the BranchHistoryCapped invariant).
entity SavedRepoBranch {
    repo_path: String        -- the repo this branch history belongs to
    branch: String           -- a base_branch value used for repo_path
    last_used: Timestamp     -- updated on each use; drives recency ordering

    invariant UniqueBranchPerRepo {
        for a in SavedRepoBranches:
            for b in SavedRepoBranches:
                a != b implies (a.repo_path != b.repo_path or a.branch != b.branch)
    }
}

-- Learning captures knowledge a dispatched agent discovered. Entries land as
-- approved immediately (no human approval gate) and are injected into future
-- dispatch prompts for the matching scope. The active pool is curated entirely
-- without a human in the loop, and there is no human-facing surface for it at
-- all: agents up/downvote via rate_learning, delete entries outright via
-- delete_learning, and a background job archives stale entries with a
-- non-positive score (see learnings.allium: ArchiveStaleLearning).
entity Learning {
    kind: LearningKind
    summary: String          -- one-sentence digest; injected into dispatch prompts
    detail: String?          -- extended context; returned by query_learnings
    scope: LearningScope
    scope_ref: String?       -- qualifies the scope:
                             --   scope=repo    → repo_path of the target repository
                             --   scope=epic    → string form of epic_id
                             --   scope=task    → string form of task_id
                             --   scope=user    → null (no qualifier needed)
    tags: Set<String>        -- free-form labels for filtering (e.g. "rust", "testing")
    status: LearningStatus
    source_task: Task?       -- the task whose agent proposed this entry; null for human-authored entries
    upvote_count: Integer -- net score: +1 per `helped` verdict, -1 per `wrong`
                          -- verdict. May be negative. Feeds retrieval ranking and
                          -- the stale-cleanup eligibility check (upvote_count <= 0).
    last_upvoted_at: Timestamp?
    created_at: Timestamp
    updated_at: Timestamp

    transitions status {
        approved -> archived     -- system-driven, and the only transition any
                                 -- behaviour produces: the stale-cleanup job
                                 -- archives an approved entry with
                                 -- upvote_count <= 0 untouched for the configured
                                 -- threshold (ArchiveStaleLearning)
        terminal: rejected, archived
    }
    -- rejected is terminal but has no inbound edge: it was only ever produced by
    -- the human reject action on the (now removed) TUI knowledge-base overlay.
    -- The value is retained because existing rows still hold it and must stay
    -- parseable; like archived, those rows are excluded from retrieval.

    -- Derived
    is_active: status = approved

    -- True when this learning is relevant to the given task's dispatch.
    -- task-scoped learnings are excluded from auto-injection; they surface
    -- via query_learnings on demand (see learnings.allium).
    applies_to_dispatch(task):
        status = approved
        and (
            scope = user
            or (scope = repo and scope_ref = task.repo_path)
            or (scope = epic and task.epic != null and scope_ref = str(task.epic.id))
        )

    invariant ScopeRefConsistency {
        (scope = user implies scope_ref = null)
        and (scope != user implies scope_ref != null)
    }
}

-- Retrieval records a single occasion on which a Learning was surfaced for a
-- task. One row is inserted per surfacing event, so repeated exposure
-- accumulates as separate rows. Used to drive rate_learning verdict validation
-- (a verdict's learning_id must have a matching retrieval row for the same
-- task) and to support telemetry on which entries actually fire.
entity Retrieval {
    task: Task
    learning: Learning
    source: RetrievalSource
    retrieved_at: Timestamp
}

-- See docs/specs/todo.allium for the Todo entity specification.

-- A rate_learning call evaluates a retrieved learning. The verdict is no
-- longer persisted (migration v74 dropped the learning_verdicts table); the
-- VerdictKind enum still describes the in-flight effects applied on receipt:
--   helped → increments learning.upvote_count and updates last_upvoted_at
--   wrong  → decrements learning.upvote_count (a downvote; may go negative);
--            no status change
-- See learnings.allium for the rule that applies these effects.

-- SplitPane is a runtime-only UI concept (not persisted) that tracks
-- whether the TUI is displaying a task's tmux window as a side pane.
-- It is modelled here because task lifecycle events (finish, PR creation)
-- must coordinate with split pane state.

entity SplitPane {
    active: Boolean = false
    focused: Boolean = true
    pane: TmuxPane?
    pinned_task: Task?

    @guidance
        -- At most one task can be pinned at a time.
        -- When active is true, pane must be non-null.
        -- pinned_task may be null (empty shell in the pane).
        -- focused tracks whether the TUI pane has tmux focus.
        -- Driven by crossterm FocusGained/FocusLost events
        -- (requires tmux `focus-events on`). Defaults to true.
        -- Reset to true on split entry and exit.
}

------------------------------------------------------------
-- Config
------------------------------------------------------------

config {
    tick_interval: Duration = 2.seconds
    gg_chord_timeout: Duration = 150.milliseconds   -- window for completing the vim-style `gg` chord (see VisualColumn row navigation)
    inactivity_timeout: Duration = 10.minutes
    status_message_expiry: Duration = 5.seconds
    -- How long a delivered message's flash stays on the target task's card.
    -- Long enough that a human whose attention is elsewhere still catches it;
    -- a few seconds does not clear that bar. This is the single source of the
    -- duration: both the expiry sweep that clears the tracking state and the
    -- render check that decides whether to draw the flash read it, so they
    -- cannot disagree. See "Message flash" in the Column Identity and Focus
    -- section for the appearance, and mcp-task-tools.allium (SendMessageToTask)
    -- for what triggers it.
    message_flash_ttl: Duration = 30.seconds
    notifications_enabled: Boolean = false
    pr_poll_interval: Duration = 30.seconds
    main_session_poll_interval: Duration = 10.seconds   -- cadence for the live tmux liveness check behind the main-session status-bar indicator (see dispatch.allium: MainSessionIndicator); a fixed multiple of tick_interval
    budget_poll_interval: Duration = 10.seconds
    budget_stale_after: Duration = 10.minutes
    default_feed_interval: Duration = 30.seconds   -- default cadence for feed epics with no explicit feed_interval_secs (see feeds.allium)
    mcp_port: Integer = 3142                         -- MCP server port (override via DISPATCH_PORT env var)
    -- Fallback when the repo has no origin/HEAD symbolic-ref.
    -- Runtime code inspects `git symbolic-ref refs/remotes/origin/HEAD`
    -- first and only falls back to this literal when detection fails.
    default_branch: String = "main"

    -- Editor of last resort, when the environment names none. Not a
    -- user-facing setting: the editor is chosen by the environment, and this
    -- constant only gives the fallback a name.
    --
    -- == Which editor (one rule, every surface) ==
    -- Whatever the environment names: VISUAL, else EDITOR, else this fallback.
    -- A value naming no editor at all — absent, empty, or only whitespace — is
    -- treated as unset, because `export EDITOR=` is how a shell spells "none".
    -- The value is split on whitespace into argv and executed directly with no
    -- shell, so a value carrying flags (`EDITOR="vim -p"`) works and nothing
    -- in it is expanded, globbed or word-split by a shell.
    --
    -- This governs EVERY surface that launches the user's editor: the pop-out
    -- task and epic editors (tasks.allium: EditTask, epics.allium: EditEpic)
    -- and the agent-tree editor pane (agent-tree.allium:
    -- OpenAgentTreeFileInEditor). One user setting must not mean two things in
    -- one application.
    editor_fallback: String = "vi"

    -- Staleness thresholds used by card age rendering and Staleness::from_age.
    fresh_threshold: Duration = 3.days
    aging_threshold: Duration = 7.days
    weeks_threshold: Duration = 14.days

    -- When true, the MCP update_task response carries a nudge asking the agent
    -- to call record_learning if it discovered anything non-obvious — but only
    -- when that single update_task call performs "PR finalisation": it sets
    -- status = review AND a pr-typed url, on a task that had no url before the
    -- call. Prompt encouragement only: the nudge is appended to the response
    -- text and never gates the update itself. No other tool reads this flag —
    -- in particular the wrap_up response does not (its rate_learning nudge is
    -- unconditional; see learnings.allium: WrapUpRateLearningNudge).
    -- (see mcp-task-tools.allium: PrFinalisationReflectionNudge)
    learning_reflection_enabled: Boolean = true

    -- Stale-learning cleanup: when enabled, a background job archives approved
    -- learnings whose net score is non-positive (upvote_count <= 0) and that have
    -- not been touched (updated_at) within stale_learning_threshold. Keeps the
    -- active retrieval pool free of unvalidated clutter with no human in the loop.
    -- (see learnings.allium: ArchiveStaleLearning)
    stale_learning_cleanup_enabled: Boolean = true
    stale_learning_threshold: Duration = 90.days
}

------------------------------------------------------------
-- VisualColumn
------------------------------------------------------------

-- The kanban board has two separate index spaces:
--
-- 1. VisualColumn indices (0–7): 8 sub-columns for task-status rendering,
--    each corresponding to a (parent_status, sub_status) pair or set.
--
-- 2. Navigation column indices (0–5): the h/l cursor positions. Running and
--    Review sub-columns are grouped under a single navigation position each.
--
-- VisualColumn layout (task-status rendering, left to right):
--
--   vcol# | Label            | parent_status | sub_statuses
--   ------+------------------+---------------+------------------------------
--       0 | Backlog          | backlog       | none
--       1 | Active           | running       | active
--       2 | Blocked          | running       | needs_input
--       3 | Stale            | running       | stale, crashed, conflict
--       4 | PR Created       | review        | awaiting_review, conflict  (split into "awaiting review" / "awaiting merge" sections by detach state)
--       5 | Revise           | review        | changes_requested
--       6 | Approved         | review        | approved
--       7 | Done             | done          | none
--
-- Navigation column layout (h/l cursor, left to right):
--
--   nav# | Label            | kind         | vcol range
--   -----+------------------+--------------+----------
--      0 | Backlog          | task-status  | vcol 0
--      1 | Running          | task-status  | vcols 1–3
--      2 | Review           | task-status  | vcols 4–6
--      3 | Done             | task-status  | vcol 7
--      4 | Archive          | edge         | —
--
-- Edge column (Archive):
--   - Archive (nav index 4) is the rightmost navigation column. It is only
--     rendered when it has keyboard focus (dynamic visibility). When focused
--     it shows archived tasks; when unfocused it is invisible.
--   - The edge column has no parent_status or sub_statuses; it is
--     outside the task-status model.
--
-- Navigation:
--   - h/l (or Left/Right) moves the cursor between nav indices 0–4.
--   - At nav index 0 (Backlog), h/Left is a no-op (already at leftmost edge).
--   - At nav index 4 (Archive), l/Right is a no-op (already at rightmost edge).
--   - h/Left closes the Archive column (navigates left to Done).
--   - In ViewMode::Epic the nav index is clamped to [0, 3]: Archive is not
--     reachable from the epic view.
--   - The edge column persists across data refreshes: a RefreshTasks event
--     does not move the cursor out of the edge column.
--   - Parent group boundaries are annotated in the column header.
--   - A task's visual column is determined by (task.status, task.sub_status).
--   - Switching into a different, non-empty navigation column (via h/l or
--     Left/Right) always places the cursor on the first card (row 0) —
--     never a row remembered from a previous visit to that column — and
--     clears the select-all toggle. The column also scrolls back to the
--     top so the first card is visible. A clamped no-op (already at the
--     leftmost/rightmost edge) leaves the cursor and scroll position
--     untouched. Switching into an empty column is also a no-op for the
--     cursor/toggle state, matching the [ / ] jump-to-first/last no-op on
--     an empty column. The Archive edge column keeps its own reset-to-0
--     behaviour on entry, independent of this rule.
--
-- Row navigation (cursor movement within the current column):
--   - j/k (or Down/Up) move the cursor one card at a time within the
--     currently-focused navigation column.
--   - Jump-to-top: moves the cursor to the first card (row 0) of the
--     current column. Bound to `[` and to the vim-style `gg` chord.
--   - Jump-to-bottom: moves the cursor to the last card of the current
--     column. Bound to `]` and to `G` (Shift+G).
--   - `gg`/`G` are pure aliases of `[`/`]`: they carry no new semantics.
--     They share the same behaviour on an empty column (a no-op that
--     leaves cursor/scroll/toggle untouched), the same select-all-toggle
--     clearing on a real move, and the same behaviour in the Archive edge
--     column and in ViewMode::Epic. Jump-to-top/bottom are available on
--     the main board and in epic view.
--   - G/gg are deliberately scoped to the main board and epic view only.
--     Overlays that bind g/Enter to their own actions (e.g. the Todos
--     overlay's "jump to linked item") keep those bindings; this
--     navigation does not touch overlay key handling.
--
-- The `gg` chord:
--   On the main board (Normal mode) and in epic view, `gg` is a pure
--   chord with no other meaning attached to a lone `g`:
--   - Pressing `g` with no chord pending starts a pending-chord window
--     (records the press time). Nothing else happens yet.
--   - If the next keypress is another `g` within config.gg_chord_timeout,
--     the chord completes as jump-to-top.
--   - If the next keypress is anything else — a different key, or a `g`
--     after the window has elapsed — the pending chord is simply
--     abandoned (no action fires for the lone `g`), then the new keypress
--     is processed normally.
--   - If the user goes idle after a lone `g` (no further keypress), the
--     periodic tick handler clears the stale pending chord once it is
--     older than config.gg_chord_timeout. Nothing fires; this is cleanup
--     only, not a deferred action.
--   - A pending chord is discarded (dropped, not fired) if the next input
--     transitions away from main-board Normal mode entirely (into the
--     TaskDetail or Todos overlays, or the Archive edge column) before it
--     resolves. This is a defensive simplification to stop a stale chord
--     leaking across an unrelated view transition; it is not expected to
--     be user-visible.
--   - `G` (jump-to-bottom) has no such conflict and no chord: it is a
--     direct, unconditional alias for `]`.
--
-- `space` (jump to the selected task's tmux window, or enter the
-- selected epic):
--   On the main board (Normal mode) and in epic view, a single `space`
--   press fires this action immediately — no chord, no deferred
--   resolution, no latency. (Previously this action was bound to `g`,
--   sharing its keystroke with the `gg` chord above; that coupling forced
--   every lone `g` press through the chord-timeout window. Moving it to
--   `space` removes that latency for the action's own sake, since `gg`'s
--   jump-to-top is already available, latency-free, via `[`.)
--   Multi-select (previously on `space`) moved to `v` to make room.

value VisualColumn {
    label: String
    parent_status: TaskStatus
    sub_statuses: List<SubStatus>

    -- A task belongs to this column when:
    --   task.status = parent_status and task.sub_status in sub_statuses
    contains(task): task.status = parent_status and task.sub_status in sub_statuses
}

------------------------------------------------------------
-- Column Identity and Focus
------------------------------------------------------------

-- How a navigation column tells the user (a) which column this is and
-- (b) whether it currently has the keyboard cursor. These are two
-- separate questions, and the board answers them with two separate
-- visual channels: hue answers "which column", intensity answers
-- "is it focused". Two surfaces are a named exception to that split and
-- use hue to answer the second question — see the exception in "Focus is
-- intensity, not colour-vs-absence".
--
-- == Column identity colour ==
--
-- Every task-status navigation column has an identity colour, drawn from
-- the palette and constant regardless of focus:
--
--   nav# | Column   | identity colour
--   -----+----------+----------------
--      0 | Backlog  | BLUE
--      1 | Running  | YELLOW
--      2 | Review   | PURPLE
--      3 | Done     | GREEN
--      4 | Archive  | ARCHIVE_STRIPE (a muted blue-grey)
--
-- Archive's identity is its own token, not the palette's generic grey.
-- MUTED is that generic grey — used for de-emphasised text throughout
-- the board — and it is not Archive's identity in any sense: Archive
-- resolves to ARCHIVE_STRIPE through the same per-column identity lookup
-- as every other column, and its stripe, selected frame, top rule, title
-- and scroll arrows all take that value from it. There is no separate
-- archive path and no special case; Archive is an ordinary column as far
-- as identity is concerned.
--
-- Archive's hue does sit in the same family as Backlog's — ARCHIVE_STRIPE
-- is close to a desaturated BLUE — so the two are not reliably separable
-- by hue alone. Nothing depends on their being separable: Archive is an
-- edge column rendered only while focused, so its label is the bright
-- variant at exactly the times Backlog's is the dim one, and the two never
-- appear at the same emphasis. Recorded so that a later change which made
-- hue alone load-bearing (or which brought Archive on screen unfocused)
-- knows this pair is the one that will collide first.
--
-- The identity colour is used for that column's own chrome and for its
-- *task* cards: the header label, the focused column's top rule and
-- scroll indicators, the stripe on its task cards, and the border of its
-- selected task card. A column never borrows another column's colour.
-- Nor does it lose its own — with one named exception, the top rule and
-- scroll indicators, which drop to grey while unfocused; see "Focus is
-- intensity, not colour-vs-absence". (Archive is an edge column and is only
-- rendered while focused — see the VisualColumn section — but it carries
-- an identity colour on the same terms as the rest while it is on
-- screen.)
--
-- Epic cards are the exception: an epic is its own identity object and
-- takes PURPLE wherever it sits, ignoring its column's identity. See
-- "Epic cards".
--
-- Hue on the board is reserved to these surfaces:
--   - the column header *label*, at both focus states — dimmed toward the
--     fill while unfocused, brightened toward white while focused. The
--     label, not the bar it sits on, is where a column's identity lives;
--     the bar's fill is neutral ("Column header bar").
--   - the top rule above the card list and the scroll indicators (▲/▼),
--     but only while the column is focused: unfocused, both go grey.
--     They sit immediately below the header bar but do not behave like
--     it — see the exception in "Focus is intensity, not
--     colour-vs-absence".
--   - the per-card stripe accent.
--   - the per-card state indicators, which carry their own semantic hues
--     (crashed, needs-input, and so on) rather than the column's.
--   - the selected card's border.
--   - an epic card's stripe and selected border, and an epic breadcrumb
--     header row, all in PURPLE regardless of column ("Epic cards").
--   - the panel enclosing the columns in Epic view, faintly purple as a
--     mode signal ("Column ground and card surface").
--
-- Everything else is neutral: the column ground, the header bar's fill,
-- the card surface, a resting card's border, the column separator, and
-- the fill behind the select-all checkbox. The first three are the
-- board's three large flat areas and all three are uniform — the same
-- value in every column at a given focus state, with focus moving them
-- along a neutral ramp rather than tinting them. See "Column ground and
-- card surface".
--
-- == Focus is intensity, not colour-vs-absence ==
--
-- Previously an unfocused column header rendered in a flat neutral grey,
-- discarding its identity colour entirely; only the focused column
-- showed colour at all. That is replaced.
--
-- The rule: on the header label, the column's identity colour is always
-- visible and focus modulates emphasis only.
--   - An unfocused column's header label keeps its identity colour at
--     reduced emphasis — the hue dimmed toward the bar's fill, still
--     unmistakably that column's colour.
--   - The focused column's header label is distinguished by increased
--     emphasis: the same hue brightened toward white, plus bold.
--   - The focused column's ground, and its header fill, are each one step
--     lighter than an unfocused column's, and both steps are *neutral*:
--     focus raises their lightness, it does not tint them.
--
-- The label is where this principle lives, and it is the only surface on
-- which it lives. That is a narrowing: the header *bar* used to carry a
-- wash of the hue at both focus states and was the principle's main
-- exhibit. Its fill is now neutral and uniform across every column, so it
-- has no colour to modulate — the whole hue channel on a column header is
-- the label, and the whole intensity channel is that label's brightness
-- plus two neutral steps behind it.
--
-- The change makes the principle read more cleanly rather than less. Hue
-- is now genuinely constant per column and brightness is the only thing
-- focus moves, where before "a stronger wash of the hue" mixed the two
-- channels together in one surface. Focus used to be signalled by a
-- tinted ground, then by a stronger hued bar; it is now a brighter
-- neutral ground, a brighter neutral fill and a brighter label. What
-- keeps moving is which surface carries the intensity; that intensity,
-- not presence-of-colour, is the signal has not moved.
--
-- Rationale: a board where only one column's label carries colour reads
-- as flat and inert — four of the five columns look switched off. Focus
-- remains unambiguous when it is signalled by intensity, because the
-- focused column is the only one at full strength, so nothing is lost by
-- giving every column its hue back.
--
-- Named exception: the top rule and the scroll indicators.
--
-- Two surfaces do not follow the principle above, and they are named here
-- rather than left to be discovered. The thin rule above a column's card
-- list, and that column's scroll indicators (▲/▼), take the identity hue
-- while the column is focused and drop to a flat neutral grey while it is
-- not. That is colour-vs-absence — precisely the mechanism this
-- subsection replaced on the header label — and it is deliberate: those two
-- surfaces signal focus by *gaining* hue rather than by intensifying it.
--
-- The reason is size, not oversight. A top rule is a one-cell-tall
-- hairline, and a dimmed hue at that size is not distinguishable from
-- grey in practice, so the reduced-emphasis treatment that works on a
-- text label buys nothing here — it would spend a hue to produce
-- something the eye reads as grey anyway. Nothing is lost from that
-- region of the screen either, because the header label sits immediately
-- above the rule and carries the column's identity at rest. The identity
-- is still there to be read; it is only the hairline that stops
-- restating it.
--
-- So the two surfaces are adjacent but not one channel. The header label
-- keeps hue at reduced emphasis when unfocused; the top rule abandons hue
-- entirely. Surfaces that behave oppositely under focus are not the same
-- channel, and an earlier reading of this spec that grouped them as one
-- was wrong.
--
-- Scope: this exception covers the top rule and the scroll indicators and
-- nothing else. It is not a general licence to drop hue when unfocused.
-- Every other identity-bearing surface — the header label, the card
-- stripe, the selected card's border — keeps its hue at both focus
-- states, and dropping hue anywhere else would be a regression against
-- the principle rather than an extension of this exception.
--
-- == Column header bar ==
--
-- The header *label* is the column's identity surface. It is what makes
-- the column identifiable, and it is the only surface asked to carry that
-- job. The bar it sits on is neutral.
--
-- Each column header renders as a filled bar showing a focus prefix
-- (`▸` when focused, `◦` when not), the column label uppercased, and the
-- count of selectable items in that column, the count at reduced emphasis
-- relative to the label.
--
-- The bar's fill is near-neutral and uniform: the same value in every
-- column at a given focus state, with the focused fill one step lighter
-- than the unfocused one. It carries no hue and no per-column variation —
-- it is a third large flat neutral area alongside the column ground and
-- the card surface, and it belongs with them rather than with the hued
-- surfaces.
--
-- All of the column's identity is therefore in the label's text colour,
-- and neither of its two values is the palette token itself:
--   - unfocused: the identity hue mixed part-way toward the bar's fill.
--     Reduced emphasis, still unmistakably that column's colour.
--   - focused: the identity hue mixed part-way toward white. Brighter,
--     plus bold.
--
-- "Mixed from" is a derivation, not a description of two colours that
-- happen to look related. Both label values are computed from the column's
-- identity hue, so changing a hue moves that column's labels with it and
-- the three cannot fall out of step. This matters more than it would for
-- an ordinary rendering detail: the label is the only surface carrying
-- column identity, so a label that had drifted from its hue would leave
-- the identity colour with nowhere legible to appear at all.
--
-- This replaces a header bar whose fill was a darkened wash of the
-- identity hue at both focus states. Two hued treatments were stacked in
-- one surface — a hued fill under hued text — and the fill was the
-- weaker of the two while occupying almost all of the area. Neutralising
-- it concentrates the column's hue in the text, which is where it is
-- legible, and puts the header on the same neutral ramp as the rest of
-- the board's large areas.
--
-- One consequence is worth stating plainly, because it is easy to assume
-- otherwise: the literal palette token is now rendered on exactly two
-- surfaces, the card stripe and the selected card's frame. Every other
-- identity-bearing surface is a derivation of it — the header label is
-- dimmed or brightened, and the top rule and scroll indicators are the hue
-- only while focused. So the palette token as written appears in only two
-- places, one of which is a one-quarter block a couple of pixels wide and
-- the other of which is present on at most one card at a time.
--
-- The focused column's header additionally carries the select-all
-- checkbox indicator, and behind that checkbox sits a single neutral fill
-- marking it as a selectable cursor target within the header. That fill is
-- one value shared by every column — the same neutral as a resting card's
-- border, so the checkbox reads at the same level as a card's edge rather
-- than as a thing of its own kind.
--
-- It was previously a per-column hued ramp — a third one, after the header
-- fill and the superseded card tint — and dropping it removes a whole
-- per-column ramp rather than retuning one. With no hued fill anywhere
-- else on the board, a hued checkbox would have been the only one and
-- would have read as an oversight. Nothing about the checkbox varies by
-- column any more: neither its fill nor its presence depends on which
-- column it is in, only on whether that column is focused and is not the
-- Archive edge column.
--
-- The checkbox is recorded here because the header bar is where it is
-- rendered. Its *behaviour* — what toggling it selects, and how that
-- interacts with the multi-selection the batch rules in tasks.allium
-- operate on — is not specified anywhere; see the open question at the end
-- of this file. An earlier version of this paragraph claimed it was
-- specified in tasks.allium, which was a pointer to nothing.
--
-- The Archive edge column never shows the checkbox, even though it is
-- always focused while on screen: there is no batch operation over
-- archived items for it to select for.
--
-- == Column ground and card surface ==
--
-- The board's ground is uniform and neutral. Every task-status column
-- renders the *same* ground colour at the same focus state: there is no
-- per-column tint and no column ground carries hue. Columns are
-- divided by a neutral separator, not by a change of colour.
--
-- "No hue" is a claim about *column* grounds. Epic view tints the panel
-- that encloses the columns with a faint purple ground, as a mode signal
-- — it says "you are inside an epic", not "this column is purple" — and
-- the column grounds inside that panel stay neutral and uniform. The two
-- do not conflict: one is the board's frame, the other is the board.
--
-- This replaces the earlier per-column tinted ground. Tinting five
-- adjacent full-height panels put hue everywhere and so left hue with
-- nothing to mean; the board now spends its colour budget on the header
-- labels and on the one selected card.
--
-- The header bar's fill joined this treatment later and on the same
-- terms: ground, header fill and card surface are the board's three large
-- flat areas, all three uniform across columns, all three neutral, and
-- all three moved by focus along a neutral ramp rather than tinted. No
-- flat area on the board carries hue. Only text, hairlines and card
-- frames do.
--
-- Cards are raised off that ground. Every card — not only the cursor
-- card — renders on a card surface one step lighter than any column
-- ground, so a column reads as a stack of lit objects on a dark
-- ground. The neutral ramp therefore has three steps in strictly
-- ascending lightness:
--
--   column ground, unfocused  <  column ground, focused  <  card surface
--
-- Note what that ordering is *not*. It is not "everything in an
-- unfocused column is darker than everything in a focused column". The
-- card surface is a single value shared by every column, so a card in an
-- unfocused column is legitimately lighter than the ground of the
-- focused column next to it. The ramp orders surfaces, not columns, and
-- there is no single global chain from "least focused thing" to "most
-- focused thing".
--
-- The *unfocused* ground sits one step below the bare terminal
-- background, so an unfocused column reads as a recessed panel that its
-- cards stand proud of. Only that one step is recessed: the focused
-- ground crosses back over and sits just above the terminal background,
-- which is part of how focus reads — the focused column comes forward
-- while its neighbours stay sunk. Each step must stay distinguishable
-- from the step below it: a difference nobody can see is the same defect
-- as no difference at all.
--
-- The recession is measured against a terminal background the app never
-- paints. The board draws its own grounds but leaves the terminal's own
-- background wherever it draws nothing, so "below the terminal
-- background" is a claim about the dark theme this palette is designed
-- for (a near-black around #1a1b26), not a property the app controls or
-- can check. On a light terminal the relation inverts and the board
-- reads as raised rather than recessed. This is an accepted assumption,
-- not an oversight: it is unenforceable against an arbitrary theme, and
-- a test can only pin the palette's own numbers, never what the user's
-- terminal is actually showing behind them.
--
-- == Selection ==
--
-- The cursor (selected) task card is marked by two things:
--   - its frame is drawn in the column's identity colour, and
--   - its title is bold.
--
-- Its fill does not change. A selected card's surface is exactly a
-- resting card's surface. Selection is the top of the emphasis ladder
-- but it is *not* a fourth step of the lightness ramp — its emphasis is
-- carried by border hue and title weight, neither of which is a tint.
-- A test that asserts "selected is lighter than resting" is asserting
-- something this design deliberately does not do.
--
-- Of those two markers only the frame hue is unambiguous. Bold weight is
-- shared with three other states, so bold on a card does not mean "this
-- is the cursor":
--   - a multi-selected card (batch selection) takes a bold title as well
--     as a leading `*` in its fixed prefix, so bold reads as "cursor or
--     multi-selected";
--   - a flashing card applies bold to the whole card, not just its title
--     (see "Message flash");
--   - an epic card's title is bold unconditionally, at rest (see "Epic
--     cards").
--
-- The hued frame is therefore the cursor signal, and the bold title is a
-- reinforcement of it that carries no meaning on its own. The `*` prefix,
-- not weight, is what distinguishes a multi-selected card.
--
-- The selected card's border is the only hued *card* border on the board
-- at a given moment. That exclusivity is what makes the cursor findable
-- without scanning. Two qualifications: hued column chrome (the focused
-- column's top rule, its scroll indicators) is not a card border and is
-- unaffected; and there is one time-bounded exception on cards
-- themselves, the message flash, below.
--
-- Deliberately out of scope: using the card border to carry task state
-- (red for Crashed/Conflict, yellow for NeedsInput). Neutral resting
-- borders make that possible for the first time, but it is deferred and
-- is not specified here.
--
-- == Card stripe ==
--
-- Every card carries a one-quarter left block (▎ U+258E) immediately
-- left of the id, in the column's identity colour on a task card and in
-- PURPLE on an epic card ("Epic cards"). The cursor card
-- uses the same glyph as every other card. The earlier behaviour — the
-- cursor card swapping in a half block (▌ U+258C) while resting cards
-- used the quarter block — is replaced; selection is carried by the
-- hued border and the bold title alone, and stripe weight no longer
-- moves with the cursor.
--
-- The stripe is an accent, not the identity carrier. At normal terminal
-- font sizes a quarter block is roughly two pixels wide, which is too
-- little area for a hue to be legible. It echoes the header label for a
-- reader who is already oriented; it does not make a card identifiable
-- in isolation, and this spec makes no such claim. The header label is
-- the identity surface.
--
-- Note that the stripe nevertheless renders the *literal* palette token,
-- which the header label does not — see "Column header bar". The smallest
-- hued surface on the board is the one showing the identity colour
-- exactly. That is not a contradiction of the paragraph above: showing a
-- colour exactly and showing enough of it to be read are different
-- things, and it is the second that makes a surface an identity carrier.
--
-- == Epic cards ==
--
-- An epic card is not a member of its column's identity. It is its own
-- identity object, and it carries PURPLE in every column: its stripe is
-- purple and, when it is the cursor, its frame is purple. A selected epic
-- sitting in Done frames purple, not green; the same epic dragged to
-- Backlog frames purple, not blue. The epic breadcrumb header row that
-- precedes a group of epic-owned tasks in flattened view is purple on the
-- same terms.
--
-- Intent: an epic is a container, not a task, and it reads as a different
-- *kind* of thing rather than as a task that happens to be in a
-- particular column. Column identity answers "what status is this"; for
-- an epic, "this is an epic" is the more useful thing for colour to say,
-- and the column it sits in is already legible from its position.
--
-- One consequence must be stated because it breaks a rule that holds
-- everywhere else: an epic card's title is bold **at rest**,
-- unconditionally. Bold is therefore not a cursor signal on an epic card
-- at all, and the frame hue is the *only* thing that distinguishes a
-- selected epic from a resting one. Where a task card has two markers of
-- which one is ambiguous, an epic card has exactly one, and it is not
-- ambiguous. Anything that later weakens the frame-hue signal on epics —
-- for instance giving resting epic frames a hue too — removes the only
-- cursor cue they have.
--
-- Everything else about an epic card is unchanged from a task card: the
-- neutral card surface, the neutral resting frame, the lit frame, the
-- one-cell inset and the four-cell horizontal chrome all apply
-- identically.
--
-- == Task card frame ==
--
-- A task card is a discrete framed box, not a run of text separated
-- from its neighbours by a rule. Every card draws its own complete
-- frame — rounded top and bottom borders plus left and right rails —
-- so that a card is bounded on all four sides and no two cards share a
-- border.
--
-- The whole card is lit, frame included. The border rows and the side
-- rails carry the *card surface* background, not the column ground, so
-- a card's boundary is the change of colour at its outer edge and the
-- frame reads as belonging to the card. The rejected alternative was to
-- paint the border on the column ground and confine the lift to the
-- frame's interior; that makes the frame read as a hairline drawn on the
-- board rather than as the edge of an object.
--
-- The card is inset from the column by one cell on each side. A card
-- does not span the full column width: a one-cell margin of the
-- column's neutral ground shows to its left and to its right, so cards
-- float inside the column rather than tiling flush against its edges and
-- against the column separator. Those margin cells are ground, not card
-- surface — the card surface fills the card and stops at the margin.
--
-- The inset and the lit frame are one mechanism seen from two sides. The
-- lift is what makes the card read as raised; the margin is what makes
-- its outer edge a visible boundary rather than a butt-joint with the
-- column edge, the separator, or a neighbouring column's card.
--
-- The inset is horizontal only. There is no blank row above or below a
-- card: vertically adjacent cards put their bottom and top borders on
-- consecutive rows, with no ground showing between them. So "cards float
-- inside the column" is true left-to-right and not top-to-bottom, and a
-- run of cards reads as a stack in contact rather than as four
-- independently floating boxes. What still holds is that each card owns
-- its own complete border — two touching borders are two borders, not one
-- shared rule — which is what "no two cards share a border" above means.
-- Vertical breathing room was not traded away for width; it was never
-- there, and adding it would cost a further row per card on top of the
-- frame's existing one.
--
-- The frame colour is neutral for a resting card and the column's
-- identity colour for the selected card. This is the one place on the
-- board where hue, not merely intensity, moves with state — see
-- "Selection". It is also a departure from the frame's previous rule,
-- under which every frame was hued and only its intensity moved.
--
-- The frame is what makes the column read as a stack of objects rather
-- than as a paragraph. It costs one line per card over the previous
-- shared-rule presentation (four lines: top border, title, metadata,
-- bottom border), which is the intended trade: fewer cards visible, but
-- each unambiguously a card.
--
-- Horizontally it costs four cells per row: two ground margins plus two
-- frame rails. The pre-frame presentation spent none of the column width
-- on chrome; a framed-but-flush card would spend two; the inset framed
-- card spends four. Every one of those cells comes out of the title
-- budget, on top of the fixed prefix each card already carries
-- (selection marker, stripe, id).
--
-- That trade is accepted, but it is tight rather than comfortable, and it
-- is tightest in the narrowest column. With the Archive edge column on
-- screen the board divides five ways, so on a 120-cell terminal a card
-- has roughly a dozen cells left for its title. A title that fitted
-- before the inset can be truncated after it, with no slack in between —
-- this is a real effect and not a hypothetical one.
--
-- Nothing adapts. The margin is one cell at every terminal size and
-- every column count; there is deliberately no width-conditional or
-- column-count-conditional branch, and none is wanted. If the title
-- budget later needs to grow, the levers are to narrow or drop the
-- margin, or to show fewer columns at once — the first paid for by
-- losing the card's outer boundary, the second by losing board breadth.
-- The trade is recorded here so that it is read rather than
-- rediscovered.
--
-- == Message flash ==
--
-- When a message is delivered to a task, that task's card flashes for
-- config.message_flash_ttl: an envelope glyph, a distinct warm fill, and
-- a frame in the column's identity colour.
--
-- The duration is a notice, not a blink. It is set long enough that a
-- human whose attention is elsewhere — reading a diff, watching another
-- agent — still catches the card on their next glance at the board. A
-- few seconds does not clear that bar; the flash would routinely begin
-- and end while nobody was looking at it, which is the same as not
-- flashing.
--
-- The hued frame is a deliberate, bounded exception to "the selected
-- card's border is the only hued *card* border on the board". While a
-- flash is live there may be two hued card borders.
--
-- The exception is safe because of the envelope, not because of the
-- clock. What resolves the ambiguity is that a flashing card carries two
-- marks the selected card never has: the envelope glyph, and a fill that
-- differs from the shared card surface (it is the only card on the board
-- of which that is true). Either one tells the reader which card is the
-- cursor and which is merely flashing, without reference to how long the
-- flash has left to run. (The flash also applies bold to the whole card
-- rather than to the title alone — see "Selection", where that is one of
-- the reasons bold carries no cursor meaning by itself.)
--
-- Boundedness is a fact about the flash but is not the justification for
-- the exception. An earlier version of this subsection leaned on the
-- flash being short-lived, which was a weak argument even then and does
-- not survive a duration this long: "it will be gone in a moment" is not
-- a reason a shared hue is unambiguous while it is on screen.
--
-- Resolved: the flash keeps the column's identity hue rather than taking
-- a hue of its own. A dedicated hue would solve a problem the envelope
-- already solves, and would spend a colour to do it.
--
-- That resolution rests on one property, and it is the property to
-- protect: the envelope and the hued frame are co-terminous. The glyph is
-- present for exactly as long as the frame is hued, both governed by the
-- single config.message_flash_ttl, so the disambiguator never expires
-- before the ambiguity does. Splitting them — expiring the glyph early,
-- or holding the hued frame past the glyph — would leave a window in
-- which a card shows the column's hue on its border with nothing to say
-- it is not the cursor, and the exception would stop being safe. Anyone
-- giving the two different lifetimes is removing the reason this design
-- is sound, not making a cosmetic change.
--
-- == Where these rules are enforced ==
--
-- Coverage is partial, and the gaps are listed below rather than left to
-- be assumed. src/tui/tests/rendering.rs carries these tests:
--
--   board_ground_is_uniform_across_columns       uniform neutral ground
--   focused_column_ground_is_distinct_from_unfocused
--   neutral_ramp_is_strictly_ascending           the three-step ramp
--   board_ground_is_recessed_below_terminal_background
--   selection_does_not_lift_the_fill             selected fill = resting
--   resting_card_border_is_neutral               iterates all five columns
--                                                through the identity
--                                                lookup, Archive included
--                                                and not special-cased, so
--                                                Archive's rendered
--                                                identity is covered by the
--                                                same loop as the rest
--   every_card_frame_is_lit_by_the_card_surface  all four corner glyphs
--   cards_are_inset_by_one_cell_of_column_ground margin width, its ground
--                                                colour, and the lit rail
--                                                inside it
--   only_the_selected_card_has_a_hued_frame
--   render_v2_task_card_shows_stripe
--   unfocused_column_header_keeps_its_identity_colour
--                                                the principle above, on
--                                                the header label: guards
--                                                against the superseded
--                                                flatten-to-grey
--   header_fill_is_uniform_across_columns        the fill is the same in
--                                                every column at a given
--                                                focus state and carries
--                                                no hue; all five columns,
--                                                both focus states
--   header_label_is_hued_in_every_column_at_both_focus_states
--                                                two guards: no label
--                                                collapses into its own
--                                                fill, and no two columns
--                                                share a label colour —
--                                                the label being the only
--                                                per-column signal left
--   focused_header_label_is_brighter_than_unfocused
--                                                focus moves the label's
--                                                brightness, which is what
--                                                "focus is intensity"
--                                                reduces to on the header
--   each_header_label_keeps_its_column_hue_signature
--                                                the labels really are
--                                                derived from their hue:
--                                                each keeps the channel
--                                                *ranking* of its source
--                                                at both focus states
--
-- That last one pins the derivation, and its formulation is deliberate:
-- the property is channel *ranking*, not distance from the source hue. The
-- obvious test — "each label is nearer its own hue than any other
-- column's" — is unsatisfiable, because a dimmed colour is by construction
-- far from the colour it was dimmed from. Measured that way Backlog's
-- dimmed label lands nearer ARCHIVE_STRIPE than BLUE, and Review's nearer
-- BLUE than PURPLE, while both are correctly derived. Ranking is the right
-- fingerprint because it survives linear mixing toward any neutral: BLUE
-- is b > g > r and stays so dimmed or brightened, PURPLE is b > r > g
-- throughout. Anyone reaching for a distance metric here will find it
-- fails on correct code — that is the trap, not a bug.
--   render_card_message_flash_shows_envelope     the flash's glyph
--   message_flash_envelope_outlives_the_old_three_second_window
--                                                the glyph is still drawn
--                                                well past the superseded
--                                                short window
--   message_flash_expires_once_past_its_ttl      the other side of the
--                                                threshold: swept, and no
--                                                longer drawn
--   message_flash_render_and_sweep_share_one_threshold
--                                                the sweep and the renderer
--                                                read one duration, so they
--                                                cannot disagree about
--                                                whether a flash is live
--
-- The superseded three-level tint ladder (unfocused < focused < cursor
-- card) was replaced rather than retuned, because a selected card no
-- longer differs from a resting one by fill at all.
--
-- Not enforced by any test — normative claims above that a reader should
-- not assume are covered:
--   - Epic cards: the PURPLE stripe and selected frame in every column,
--     and the unconditionally bold title ("Epic cards").
--   - The four-cell horizontal chrome total as a number. The inset test
--     pins the margin's width, but nothing asserts the sum the title
--     budget is reduced by.
--   - Cross-column exclusivity of the hued card frame.
--     only_the_selected_card_has_a_hued_frame renders Backlog tasks only,
--     so it cannot catch a hued frame appearing in another column, nor an
--     epic's purple frame.
--   - That the flash's hued frame and its envelope are co-terminous. The
--     tests above pin the *glyph* against the TTL on both sides, but none
--     of them looks at the frame's colour, so a change that expired the
--     hue and the glyph at different times would pass. That is the one
--     property the "Message flash" resolution rests on, and it is the
--     least guarded thing in this section.
--   - The top rule's and scroll indicators' colour at *either* focus
--     state: neither that they take the identity hue while focused nor
--     that they drop to grey while unfocused. The named exception in
--     "Focus is intensity, not colour-vs-absence" is therefore entirely
--     unguarded, and the header-label test above does not cover it — a
--     change that flattened the focused rule to grey, or that gave the
--     unfocused rule a dimmed hue, would pass the suite either way.
--
-- Naming tests here couples this spec to them: renaming or deleting one
-- must update this list. That coupling is deliberate, and
-- ./scripts/check-doc-symbols.sh enforces it — a citation that stops
-- resolving fails the pre-push hook rather than rotting quietly.
--
-- The lit frame and the one-cell inset are both produced by
-- src/tui/ui/kanban/cards.rs::frame_card, which paints the margin cells
-- in the column ground so they do not inherit the card surface. Its
-- chrome total (`CARD_CHROME_WIDTH`) is what the title budget is reduced
-- by, so a change to the margin moves truncation on every card.

-- archive_stripe is Archive's own identity token. muted is the palette's
-- generic grey for de-emphasised text, and is not any column's identity.
enum PaletteToken { blue | yellow | purple | green | archive_stripe | muted }

value ColumnChrome {
    -- The column's identity colour. Not a function of focus.
    identity_colour: PaletteToken
    focused: Boolean
    is_archive_edge_column: Boolean

    -- The only two surfaces that render the identity colour itself. Both
    -- are on cards, and between them they are every place the literal
    -- palette token reaches the screen (see "Column header bar"). Epic
    -- cards are not among them: they carry their own identity — see
    -- EpicCardChrome.
    task_card_stripe_colour: identity_colour
    selected_task_card_border_colour: identity_colour

    -- The top rule and scroll indicators, but only while focused.
    -- Unfocused, both drop to a flat neutral grey rather than to a dimmed
    -- hue: they are the named exception to "Focus is intensity, not
    -- colour-vs-absence", signalling focus by gaining hue instead of by
    -- intensifying it.
    focused_top_rule_colour: identity_colour
    focused_scroll_indicator_colour: identity_colour

    -- The header label is *derived from* identity_colour at both focus
    -- states and equals it at neither, so it is recorded as prose rather
    -- than as a derivation — writing `= identity_colour` would be false
    -- (see "Column header bar"):
    --   unfocused label   the hue mixed part-way toward the bar's fill.
    --   focused label     the hue mixed part-way toward white, plus bold.
    --
    -- Neither the header fill nor the select-all highlight appears in this
    -- value at all any more. Both are neutral and uniform across columns,
    -- so neither is a function of identity_colour: the fill belongs with
    -- the column ground and the card surface on the neutral ramp
    -- (BoardNeutralRamp), and the select-all highlight is a single shared
    -- value. The select-all highlight used to be a per-column hued ramp;
    -- it was removed rather than retuned.

    -- Focus modulates emphasis only, never presence of colour.
    header_label_bold: focused

    -- Task-status columns only. The Archive edge column never shows the
    -- checkbox even though it is always focused while on screen: there is
    -- no batch operation over archived items for it to select for.
    shows_select_all_checkbox: focused and not is_archive_edge_column
}

value EpicCardChrome {
    -- An epic is its own identity object: its chrome does not depend on
    -- the column it sits in, and identity_colour here is purple in every
    -- column.
    identity_colour: PaletteToken
    selected: Boolean

    stripe_colour: identity_colour
    selected_frame_colour: identity_colour

    -- Bold at rest, unconditionally — so weight carries no cursor
    -- information on an epic card and the frame hue is the only cursor
    -- signal it has.
    title_bold: true
    frame_hue_marks_cursor: selected
}

value BoardNeutralRamp {
    -- Relative lightness on a shared scale whose zero point is the bare
    -- terminal background; values below it are negative. Only the
    -- ordering is normative — the absolute values are a rendering
    -- concern. Every quantity here is neutral: this ramp has no hue
    -- axis, and hue never enters it (see "Column identity colour").
    --
    -- These are surfaces, not focus levels. There is no global chain
    -- from least- to most-emphasised: card_surface is shared by focused
    -- and unfocused columns alike, so it outranks both grounds.
    column_ground_unfocused: Integer
    column_ground_focused: Integer
    header_fill_unfocused: Integer
    header_fill_focused: Integer
    card_surface: Integer
    selected_card_surface: Integer

    -- Focus raises the ground; cards sit above every ground.
    invariant NeutralRampIsStrictlyAscending {
        column_ground_unfocused < column_ground_focused
            and column_ground_focused < card_surface
    }

    -- The header bar's fill is on this ramp too, and behaves like the
    -- ground: focus raises it, and it stays below the card surface so that
    -- cards remain the lightest thing on the board.
    --
    -- How the two header values interleave with the two ground values is
    -- deliberately not asserted. Each surface is ordered against itself
    -- under focus and against the card surface; a relation between, say,
    -- header_fill_unfocused and column_ground_focused would be pinning an
    -- arithmetic coincidence rather than a design decision.
    invariant HeaderFillRisesWithFocusAndStaysBelowCards {
        header_fill_unfocused < header_fill_focused
            and header_fill_focused < card_surface
    }

    -- An unfocused column's ground is recessed relative to the terminal
    -- it is drawn in, so its cards read as raised rather than inset. Only
    -- the unfocused ground: column_ground_focused crosses back above zero,
    -- which is part of how focus reads.
    --
    -- The zero point is an assumption, not something the app controls.
    -- Nothing here ever paints a terminal background — the terminal's own
    -- background shows wherever the board draws nothing — so this holds
    -- against the dark theme the palette is designed for and is false at
    -- runtime on a light terminal. It is unenforceable against an
    -- arbitrary theme: a test can pin the palette's numbers and will pass
    -- regardless of what the user's terminal is actually showing behind
    -- them.
    invariant GroundIsRecessedBelowTerminalBackground {
        column_ground_unfocused < 0
    }

    -- Selection is not a fill lift. The selected card's surface is
    -- identical to a resting card's; its emphasis lives in border hue
    -- and title weight, which are off this ramp entirely. Stating it as
    -- an equality rather than omitting it keeps the old `<` from being
    -- reintroduced by anyone reading the ramp as an emphasis ladder.
    invariant SelectionDoesNotLiftTheFill {
        selected_card_surface = card_surface
    }
}

------------------------------------------------------------
-- FlattenedView
------------------------------------------------------------

-- The task board has two rendering modes: the default hierarchical mode
-- and a flattened mode that surfaces every descendant task of the
-- current scope directly into its visual column, bypassing the
-- epic/sub-epic grouping.
--
-- Intent: when work is spread across nested epics, users often need to
-- see at a glance which tasks are running, blocked, or awaiting review
-- without drilling into each epic individually. The flattened mode
-- answers that need without changing any task data.
--
-- Scope: determined by the current view.
--   - Main board view: scope is every non-archived task that passes the
--     active repo filter, regardless of epic membership or depth.
--   - Epic view: scope is every non-archived task whose epic chain
--     (epic_id, then epic.parent, recursively) roots at the current
--     epic, plus any task directly under it. The repo filter still
--     applies.
--
-- Rendering:
--   - Task cards appear in their normal visual column, determined by
--     (task.status, task.sub_status), exactly as in hierarchical mode.
--   - Epic cards are not rendered in flattened mode — neither root
--     epics on the board nor sub-epics inside an epic view.
--   - Task cards belonging to an epic show the epic's id (rendered
--     in a distinguishing colour) appended to the card's indicator
--     line, so epic membership remains visible on the card.
--   - The decorative epic-header rule that precedes each epic's task group
--     shows that epic's full ancestor breadcrumb: the root ancestor first and
--     the epic's own title last, segments joined with " › ". The breadcrumb is
--     bounded by the column width; when it does not fit, every segment is
--     truncated to keep a visible prefix, sharing the available width fairly
--     across segments. A root epic (no ancestors) shows just its own title,
--     unchanged from prior behaviour.
--
-- State model:
--   - Flattened is a single board-level boolean, toggled by the user.
--   - The value is preserved as the user navigates into sub-epics and
--     back out: drilling down or exiting an epic does not change it.
--   - It is session-scoped and does not persist across app restarts.
--
-- Interaction:
--   - Task-card actions (dispatch, go-into-task, expand-description)
--     behave identically in both modes. A flattened task card always
--     acts on the task itself, never on its ancestor epic.
--   - To navigate into an epic, the user first turns flattened mode
--     off; epic cards then become visible and selectable.

value FlattenedView {
    active: Boolean

    -- In flattened mode, the board renders only tasks in scope, never
    -- epics. In hierarchical mode (active = false), rendering follows
    -- the default rules (root epics on the board, sub-epics and direct
    -- tasks inside each epic view).
    renders_epics: not active

    -- A task is in scope for the current view when flattened is active.
    in_scope(task, view):
        not task.archived
        and task.repo_path in view.active_repo_filter
        and (view.is_board or task.is_descendant_of(view.current_epic))
}

-- == Only Active Filter ==

-- only_active_filter:
--   When view.only_active is true, only tasks where tmux_window is set
--   are included in tasks_for_current_view. This filter is applied in
--   addition to the repo filter.
--   The filter is toggled via the [f] overlay's "Active sessions only"
--   row (cursor position 0, Space to toggle).
--   The filter is session-scoped and does not persist across app restarts.

-- == Board Search Filter ==

-- board_search_filter:
--   When view.search_query is non-empty, the query narrows BOTH task cards and
--   epic cards. An empty query matches everything. This filter is applied in
--   addition to the repo filter and the only-active filter (logical AND).
--
--   own_match(entity) — the shared per-entity predicate. It holds when EITHER
--   sub-predicate holds (logical OR):
--     title match: a case-insensitive forward subsequence of entity.title (every
--       query char appears in the title, in order) — the same predicate used by
--       the repo-path picker (fuzzy_matches).
--     id-prefix match: the query, after stripping one optional leading '#', is
--       non-empty and consists entirely of ASCII digits, and the decimal
--       spelling of entity.id starts with those digits. So "38" matches #38,
--       #380 and #3837 (progressive narrowing as the user types) but not
--       #1385; "#3837" matches #3837; "3a" and a bare "#" have no digit
--       payload and so fall back to title matching alone.
--
--   Tasks: a task is included in tasks_for_current_view when own_match(task)
--   holds. This applies in the board view and inside an epic view alike: an
--   epic that was surfaced by its own title still shows only those subtasks
--   that match the query, which may be none. Clearing the query is how the
--   user sees an epic's full contents.
--
--   Epics: an epic card is visible when own_match(epic) holds, OR when some
--   descendant sub-epic satisfies own_match AND is itself visible under the
--   repo and only-active filters, OR when some non-archived task in the
--   epic's subtree satisfies own_match AND is itself visible under the repo
--   and only-active filters (the same two predicates tasks_for_current_view
--   applies to a task: filter.matches on repo_path, and the only-active
--   filter). Archived tasks never keep an epic visible.
--
--   The "itself visible" clause on both the sub-epic and the task branch is
--   load-bearing: a descendant the board would hide cannot keep its ancestor's
--   card alive, because drilling into that card would be a dead end — the
--   descendant that justified the card is not there to be found. The
--   descendant clause exists at all because a hierarchical board does not
--   render epic-owned tasks on the board itself — the epic card is the only
--   path to them, so hiding the card would make a reachable match
--   unreachable; gating the descendant by the repo and only-active filters
--   keeps that reachability promise honest.
--
--   Epic ids and task ids are separate sequences, so one digit payload can match
--   both an epic card and a task card. Both are shown.
--
--   Epic-target pickers (reparent, move-task-to-epic) are NOT narrowed by the
--   search query — they carry their own input buffers. See the guidance on
--   ReparentEpic in epics.allium and MoveTaskToEpic in tasks.allium.
--
--   Lifecycle: the [/] key opens a live search bar and the board narrows as
--   the user types. [Enter] keeps the query active and closes the bar (the
--   filter persists, with a [/query] indicator shown on the board). [Esc]
--   in the bar restores the query that was active before the bar opened.
--   [Esc] on the board (bar closed) with an active query clears it.
--   The query is session-scoped and does not persist across app restarts.
--   Cursor re-clamping on query change is covered by selection_preservation.

-- == Cursor Selection Preservation ==

-- selection_preservation:
--   When the cursor has an anchor (a task or epic ID) and column items are recomputed
--   (on any status change, task movement, filter change, or data refresh), the cursor
--   position is resolved by locating the anchor item in the new item list.
--
--   If the anchor item is found: the cursor moves to the item's new column and row,
--   following the item if it changed columns.
--
--   If the anchor item is not present (deleted or moved outside board scope): the cursor
--   clamps to the nearest valid position in the current column.
--
--   When the cursor is on the select-all column header (on_select_all = true), the anchor
--   is None and the header state is preserved across refreshes.

------------------------------------------------------------
-- Open Questions
------------------------------------------------------------

open question "SelectAllCheckboxBehaviour: the select-all checkbox is described in 'Column header bar' as a rendered surface (focused non-Archive columns only, neutral fill, no per-column variation) and appears in selection_preservation as a cursor position (on_select_all), but what toggling it actually does is specified nowhere. tasks.allium specifies batch operations *over* a multi-selection without saying how select-all produces one: does it select every item in the column or only the visible/filtered ones, does it interact with the active search and only-active filters, is it per-column or board-wide, and does moving the cursor off the header clear it (core.allium row navigation says some movements clear the toggle, which implies the answer is partly settled in code but not written down). Where should this live - tasks.allium beside the batch rules that consume the selection, or core.allium beside the board navigation that exposes it?"
